#!/bin/sh
# Files from the machine to the computer it runs on: each FILE becomes a download of the browser the
# machine runs in (the person's Downloads folder on the Mac), as files dropped on the screen come the other
# way (into ~/Downloads here).
#
#   rv-host-save FILE...     (at most 512 MiB each; folders are not sent: pack them first, tar or zip)
#
# Dolphin has it in a file's context menu as "Save to This Computer". The download starts at once if the
# person clicked on the screen in the last few seconds (the browser lets a page start one then); otherwise the
# page asks in a box at the top of the page ("Save NAME to this computer?": Save / Cancel). hostopen/README.md has the details.
#
# Exits 0 when every file was saved or shown, 1 if one could not be read or was refused, 3 if no page
# answered.

HERE=/run/hostopen
if [ $# -eq 0 ] || [ "$1" = -h ] || [ "$1" = --help ]; then
	sed -n '2,13s/^# \{0,1\}//p' "$0"
	[ $# -ne 0 ]; exit $?
fi
if [ ! -x /run/hostnode/hostnode ] || [ ! -f "$HERE/boot.js" ]; then
	echo "rv-host-save: no hostnode here (/run/hostnode, /run/hostopen: see tools/debian-enter)" >&2
	exit 3
fi
status=0
for f in "$@"; do
	if [ -d "$f" ]; then
		echo "rv-host-save: $f is a folder (pack it first: tar czf NAME.tar.gz $f)" >&2
		status=1
		continue
	fi
	HOSTNODE_HOME=$HERE /run/hostnode/hostnode --save "$f" || status=$?
done
exit $status
