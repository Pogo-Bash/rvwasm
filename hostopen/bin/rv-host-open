#!/bin/sh
# Open a web address in the browser of the computer this machine runs on
# (the person's own Chrome), not in a browser inside the machine.
#
#   rv-host-open URL         (http and https only; "example.com" means https://example.com)
#   rv-host-open --install   make it the default web browser of this user (KDE, GTK, xdg-open), and list it
#                            in the launchers: ~/.local/share/applications/rv-host-open.desktop
#   rv-host-open --uninstall undo that (the web browser is then Debian's default again)
#   rv-host-open --off       xdg-open, x-www-browser, kde-open and $BROWSER open addresses in the machine again
#   rv-host-open --on        ... and on the host (the default)
#
# The page shows the address in its top right corner with an Open button
# (a page may open a tab only right after a click: browsers block it
# otherwise), or opens it at once if the person has just clicked on the
# screen. hostopen/README.md in the source tree has the details.
#
# Exits 0 when the page opened or showed it, 1 if it refused it, 3 if no
# page answered (an older page, or hostnode is missing).

HERE=/run/hostopen
case "$1" in
--install)
	mkdir -p "$HOME/.local/share/applications" "${XDG_CONFIG_HOME:-$HOME/.config}"
	cp "$HERE/rv-host-open.desktop" "$HOME/.local/share/applications/rv-host-open.desktop" || exit 1
	for type in x-scheme-handler/http x-scheme-handler/https; do
		xdg-mime default rv-host-open.desktop $type || exit 1
	done
	echo "rv-host-open: now the default web browser (KDE programs started before this may need a restart)"
	exit 0 ;;
--uninstall)
	rm -f "$HOME/.local/share/applications/rv-host-open.desktop"
	# (xdg-mime cannot remove a default: take the lines out of mimeapps.list)
	list="${XDG_CONFIG_HOME:-$HOME/.config}/mimeapps.list"
	[ -f "$list" ] && sed -i '/=rv-host-open\.desktop;*$/d' "$list"
	echo "rv-host-open: no longer the default web browser"
	exit 0 ;;
--off)
	mkdir -p "$HOME/.config/rv-host-open" && : > "$HOME/.config/rv-host-open/off"
	echo "rv-host-open: off (addresses open in the machine)"; exit 0 ;;
--on)
	rm -f "$HOME/.config/rv-host-open/off"
	echo "rv-host-open: on (addresses open on the host)"; exit 0 ;;
-h|--help|"")
	sed -n '2,19s/^# \{0,1\}//p' "$0"
	[ -n "$1" ]; exit $? ;;
-*)
	echo "rv-host-open: no option $1 (--help)" >&2; exit 2 ;;
esac
if [ $# -ne 1 ]; then
	echo "usage: rv-host-open URL" >&2
	exit 2
fi
# Off: what asks for a browser by $BROWSER (which is this) gets the machine's own.
if [ -e "$HOME/.config/rv-host-open/off" ]; then
	unset BROWSER
	exec /usr/bin/x-www-browser "$1"
fi
url=$1
case "$url" in
*://*) ;;
[A-Za-z]*:[0-9]*) url="https://$url" ;;	# (a host and a port)
[A-Za-z]*:*) ;;				# (some other kind of address: javascript:, mailto:, ...; refused, with the reason)
*) url="https://$url" ;;
esac
if [ ! -x /run/hostnode/hostnode ] || [ ! -f "$HERE/boot.js" ]; then
	echo "rv-host-open: no hostnode here (/run/hostnode, /run/hostopen: see tools/debian-enter)" >&2
	exit 3
fi
HOSTNODE_HOME=$HERE exec /run/hostnode/hostnode "$url"
