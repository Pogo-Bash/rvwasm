diff --git a/fs/drop_caches.c b/fs/drop_caches.c
index 49f56a598..ca79e693e 100644
--- a/fs/drop_caches.c
+++ b/fs/drop_caches.c
@@ -11,6 +11,7 @@
 #include <linux/sysctl.h>
 #include <linux/gfp.h>
 #include <linux/swap.h>
+#include <linux/syscalls.h>
 #include "internal.h"
 
 /* A global variable is a bit ugly, but it keeps the code simple */
@@ -48,6 +49,46 @@ static void drop_pagecache_sb(struct super_block *sb, void *unused)
 	iput(toput_inode);
 }
 
+/*
+ * For an allocation of many pages in one piece that has just failed for lack
+ * of such a piece, not of memory: without an MMU nothing can be moved out of
+ * the way (there is no compaction), but the page cache can be let go, and it
+ * is what lies scattered between the free pages. With `sync`, what has not
+ * been written yet is written first, so that it can go too.
+ *
+ * Not often: everything that was cached has to be read again afterwards,
+ * and the caller holds locks that every mapping in the system waits for. A
+ * program that asks for large pieces again and again, and makes do with
+ * small ones when it gets none, must not have the cache emptied each time.
+ * Returns whether anything was done.
+ */
+bool drop_caches_for_alloc(bool sync)
+{
+	static unsigned long next_drop, next_sync;
+	static DEFINE_SPINLOCK(lock);
+	unsigned long now = jiffies;
+	bool go;
+
+	spin_lock(&lock);
+	go = time_after_eq(now, sync ? next_sync : next_drop) || !(sync ? next_sync : next_drop);
+	if (go) {
+		next_drop = (now + 20 * HZ) | 1;
+		if (sync)
+			next_sync = (now + 120 * HZ) | 1;
+	}
+	spin_unlock(&lock);
+	if (!go)
+		return false;
+
+	if (sync)
+		ksys_sync();
+	lru_add_drain_all();
+	iterate_supers(drop_pagecache_sb, NULL);
+	drop_slab();
+	count_vm_event(DROP_PAGECACHE);
+	return true;
+}
+
 static int drop_caches_sysctl_handler(const struct ctl_table *table, int write,
 		void *buffer, size_t *length, loff_t *ppos)
 {
diff --git a/fs/ramfs/file-nommu.c b/fs/ramfs/file-nommu.c
index 0f8e838ec..99fa01f6f 100644
--- a/fs/ramfs/file-nommu.c
+++ b/fs/ramfs/file-nommu.c
@@ -81,7 +81,13 @@ int ramfs_nommu_expand_for_mapping(struct inode *inode, size_t newsize)
 
 	/* allocate enough contiguous pages to be able to satisfy the
 	 * request */
-	pages = alloc_pages(gfp, order);
+	pages = alloc_pages(gfp | __GFP_NOWARN, order);
+	/* (As in do_mmap_private(): the page cache may be all that is in the way.) */
+	for (int attempt = 0; !pages && order > PAGE_ALLOC_COSTLY_ORDER && attempt < 2; attempt++) {
+		if (!drop_caches_for_alloc(attempt))
+			continue;
+		pages = alloc_pages(gfp | __GFP_NOWARN, order);
+	}
 	if (!pages)
 		return -ENOMEM;
 
