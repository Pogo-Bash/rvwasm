diff --git a/drivers/block/wasm_blk.c b/drivers/block/wasm_blk.c
new file mode 100644
index 000000000..0b03e4f27
--- /dev/null
+++ b/drivers/block/wasm_blk.c
@@ -0,0 +1,117 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * The disks of Linux/Wasm.
+ *
+ * Block devices (wda, wdb, ...) whose sectors the Wasm host keeps: the kernel asks the host
+ * to read sectors into its memory or to write them from it, and the host
+ * answers when it is done. Where the sectors are is the host's business (in
+ * a browser: a file in the origin's private file system, filled from the
+ * server the first time a part of it is read). There is no interrupt and no
+ * queue: a request is carried out in the task that makes it. The host may
+ * hold back what is written until it is told to flush.
+ *
+ * The host says how large each disk is; a size of 0 is no disk, and then
+ * there is no device for it.
+ */
+#include <linux/blkdev.h>
+#include <linux/init.h>
+#include <linux/module.h>
+
+/* The size of disk `index` in 512-byte sectors, or 0 if there is none. */
+extern long wasm_driver_blk_sectors(u32 index);
+/*
+ * Read (op 0) or write (op 1) `count` sectors from `sector` on, or (op 2)
+ * see to it that what has been written is kept even if the machine stops;
+ * 0, or a negative error. Which disk is in the bits of `op` from 8 up.
+ */
+extern long wasm_driver_blk_rw(u64 sector, u8 *buf, u32 count, u32 op);
+
+#define WASM_BLK_READ	0
+#define WASM_BLK_WRITE	1
+#define WASM_BLK_FLUSH	2
+#define WASM_BLK_DISK(i) ((i) << 8)
+
+#define WASM_BLK_DISKS	4
+
+static int wasm_blk_major;
+
+static void wasm_blk_submit_bio(struct bio *bio)
+{
+	u32 which = WASM_BLK_DISK((u32)(unsigned long)bio->bi_bdev->bd_disk->private_data);
+	u32 op = (op_is_write(bio_op(bio)) ? WASM_BLK_WRITE : WASM_BLK_READ) | which;
+	sector_t sector = bio->bi_iter.bi_sector;
+	struct bio_vec bvec;
+	struct bvec_iter iter;
+
+	if ((bio->bi_opf & REQ_PREFLUSH) && wasm_driver_blk_rw(0, NULL, 0, WASM_BLK_FLUSH | which))
+		goto error;
+
+	/* (Whole runs of pages at a time. No highmem here: a page's memory is where its address says.) */
+	bio_for_each_bvec(bvec, bio, iter) {
+		u32 count = bvec.bv_len >> SECTOR_SHIFT;
+
+		if (wasm_driver_blk_rw(sector, bvec_virt(&bvec), count, op))
+			goto error;
+		sector += count;
+	}
+
+	if ((bio->bi_opf & REQ_FUA) && wasm_driver_blk_rw(0, NULL, 0, WASM_BLK_FLUSH | which))
+		goto error;
+	bio_endio(bio);
+	return;
+
+error:
+	bio_io_error(bio);
+}
+
+static const struct block_device_operations wasm_blk_fops = {
+	.owner		= THIS_MODULE,
+	.submit_bio	= wasm_blk_submit_bio,
+};
+
+static int __init wasm_blk_add(u32 index, long sectors)
+{
+	struct queue_limits lim = {
+		.logical_block_size	= SECTOR_SIZE,
+		.physical_block_size	= PAGE_SIZE,
+		.features		= BLK_FEAT_SYNCHRONOUS | BLK_FEAT_WRITE_CACHE | BLK_FEAT_FUA,
+	};
+	struct gendisk *disk;
+	int err;
+
+	disk = blk_alloc_disk(&lim, NUMA_NO_NODE);
+	if (IS_ERR(disk))
+		return PTR_ERR(disk);
+	disk->major = wasm_blk_major;
+	disk->first_minor = index;
+	disk->minors = 1;
+	disk->fops = &wasm_blk_fops;
+	disk->private_data = (void *)(unsigned long)index;
+	snprintf(disk->disk_name, DISK_NAME_LEN, "wd%c", 'a' + index);
+	set_capacity(disk, sectors);
+
+	err = add_disk(disk);
+	if (err)
+		put_disk(disk);
+	return err;
+}
+
+static int __init wasm_blk_init(void)
+{
+	int err = 0;
+
+	for (u32 index = 0; index < WASM_BLK_DISKS && !err; index++) {
+		long sectors = wasm_driver_blk_sectors(index);
+
+		if (sectors <= 0)
+			continue;
+		if (!wasm_blk_major) {
+			wasm_blk_major = register_blkdev(0, "wasmblk");
+			if (wasm_blk_major < 0)
+				return wasm_blk_major;
+		}
+		err = wasm_blk_add(index, sectors);
+	}
+	return err;
+}
+device_initcall(wasm_blk_init);
