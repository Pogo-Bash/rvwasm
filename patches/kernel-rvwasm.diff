diff --git a/drivers/video/fbdev/wasm_fb.c b/drivers/video/fbdev/wasm_fb.c
new file mode 100644
index 000000000..e832ac19c
--- /dev/null
+++ b/drivers/video/fbdev/wasm_fb.c
@@ -0,0 +1,153 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * The display of Linux/Wasm.
+ *
+ * A frame buffer of a fixed size in ordinary kernel memory. The Wasm host is
+ * told where the pixels are and shows them (in a browser: copies them to a
+ * canvas for every frame it draws); there is nothing to program and no
+ * retrace to wait for. A pixel is four bytes: red, green, blue, and one that
+ * is not used.
+ *
+ * Without an MMU a program that maps the device gets the address of this
+ * memory itself. A program that cannot use that address, because it keeps
+ * what it draws somewhere in its own memory, can have the host show its
+ * memory instead: all of Linux/Wasm is one address space, which the host
+ * sees whole. That is what the WASMFB_SET_PIXELS ioctl is for. It is how a
+ * user-mode emulator lets the program it runs draw: the mapping the guest
+ * asked for lies in the emulator's arena, and that is what is shown. The
+ * display goes back to the kernel's memory when that process closes the
+ * device, at the latest when it exits.
+ */
+#include <linux/fb.h>
+#include <linux/init.h>
+#include <linux/mm.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/sched.h>
+
+/* Show the pixels at this address from now on: `height` rows of `stride` bytes, `width` pixels in each. */
+extern void wasm_driver_fb_show(const u8 *pixels, u32 width, u32 height, u32 stride);
+
+#define WASM_FB_WIDTH	1024
+#define WASM_FB_HEIGHT	768
+#define WASM_FB_STRIDE	(WASM_FB_WIDTH * 4)
+#define WASM_FB_SIZE	(WASM_FB_STRIDE * WASM_FB_HEIGHT)
+
+/* Show the caller's memory at this address (same geometry) instead of the device's; 0 undoes it. */
+#define WASMFB_SET_PIXELS	_IOW('F', 0xa0, unsigned long)
+
+static u32 wasm_fb_palette[16];
+static pid_t wasm_fb_borrower;	/* the process whose memory is shown, or 0 */
+
+static int wasm_fb_setcolreg(u_int regno, u_int red, u_int green, u_int blue,
+			     u_int transp, struct fb_info *info)
+{
+	if (regno >= 16)
+		return 1;
+	/* (The components come as 16 bits each.) */
+	wasm_fb_palette[regno] = (red >> 8) | (green >> 8) << 8 | (blue >> 8) << 16;
+	return 0;
+}
+
+/* Without an MMU the mapping is the memory itself (see get_fb_unmapped_area()). */
+static int wasm_fb_mmap(struct fb_info *info, struct vm_area_struct *vma)
+{
+	return 0;
+}
+
+static void wasm_fb_show_own(struct fb_info *info)
+{
+	wasm_fb_borrower = 0;
+	wasm_driver_fb_show(info->screen_buffer, WASM_FB_WIDTH, WASM_FB_HEIGHT, WASM_FB_STRIDE);
+}
+
+static int wasm_fb_ioctl(struct fb_info *info, unsigned int cmd, unsigned long arg)
+{
+	if (cmd != WASMFB_SET_PIXELS)
+		return -ENOTTY;
+	if (!arg) {
+		wasm_fb_show_own(info);
+		return 0;
+	}
+	wasm_fb_borrower = task_tgid_nr(current);
+	wasm_driver_fb_show((const u8 *)arg, WASM_FB_WIDTH, WASM_FB_HEIGHT, WASM_FB_STRIDE);
+	return 0;
+}
+
+static int wasm_fb_release(struct fb_info *info, int user)
+{
+	if (user && wasm_fb_borrower && wasm_fb_borrower == task_tgid_nr(current))
+		wasm_fb_show_own(info);
+	return 0;
+}
+
+static const struct fb_ops wasm_fb_ops = {
+	.owner		= THIS_MODULE,
+	__FB_DEFAULT_SYSMEM_OPS_RDWR,
+	.fb_setcolreg	= wasm_fb_setcolreg,
+	__FB_DEFAULT_SYSMEM_OPS_DRAW,
+	.fb_mmap	= wasm_fb_mmap,
+	.fb_ioctl	= wasm_fb_ioctl,
+	.fb_release	= wasm_fb_release,
+};
+
+static int __init wasm_fb_init(void)
+{
+	struct platform_device *pdev;
+	struct fb_info *info;
+	void *pixels;
+	int err;
+
+	/*
+	 * A device for the frame buffer to belong to. Nothing here needs one,
+	 * but the X server only takes a frame buffer whose device is on a bus
+	 * (it looks for /sys/class/graphics/fb0/device/subsystem).
+	 */
+	pdev = platform_device_register_simple("wasm-fb", -1, NULL, 0);
+	if (IS_ERR(pdev))
+		return PTR_ERR(pdev);
+	info = framebuffer_alloc(0, &pdev->dev);
+	if (!info)
+		return -ENOMEM;
+	pixels = alloc_pages_exact(WASM_FB_SIZE, GFP_KERNEL | __GFP_ZERO);
+	if (!pixels) {
+		framebuffer_release(info);
+		return -ENOMEM;
+	}
+
+	info->fbops = &wasm_fb_ops;
+	info->flags |= FBINFO_VIRTFB;	/* ordinary memory, not I/O memory */
+	info->screen_buffer = pixels;
+	info->pseudo_palette = wasm_fb_palette;
+
+	strscpy(info->fix.id, "wasmfb", sizeof(info->fix.id));
+	info->fix.type = FB_TYPE_PACKED_PIXELS;
+	info->fix.visual = FB_VISUAL_TRUECOLOR;
+	info->fix.accel = FB_ACCEL_NONE;
+	info->fix.line_length = WASM_FB_STRIDE;
+	info->fix.smem_start = (unsigned long)pixels;
+	info->fix.smem_len = WASM_FB_SIZE;
+
+	info->var.xres = info->var.xres_virtual = WASM_FB_WIDTH;
+	info->var.yres = info->var.yres_virtual = WASM_FB_HEIGHT;
+	info->var.bits_per_pixel = 32;
+	info->var.red.offset = 0;
+	info->var.green.offset = 8;
+	info->var.blue.offset = 16;
+	info->var.red.length = info->var.green.length = info->var.blue.length = 8;
+	info->var.activate = FB_ACTIVATE_NOW;
+	info->var.height = info->var.width = -1;
+	info->var.vmode = FB_VMODE_NONINTERLACED;
+
+	err = fb_alloc_cmap(&info->cmap, 256, 0);
+	if (!err)
+		err = register_framebuffer(info);
+	if (err) {
+		free_pages_exact(pixels, WASM_FB_SIZE);
+		framebuffer_release(info);
+		return err;
+	}
+	wasm_fb_show_own(info);
+	return 0;
+}
+device_initcall(wasm_fb_init);
