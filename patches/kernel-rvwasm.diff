diff --git a/drivers/input/misc/wasm_input.c b/drivers/input/misc/wasm_input.c
new file mode 100644
index 000000000..e1ece61a7
--- /dev/null
+++ b/drivers/input/misc/wasm_input.c
@@ -0,0 +1,186 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * The keyboard and the pointer of Linux/Wasm.
+ *
+ * The Wasm host has the events (in a browser: what happens on the canvas
+ * that shows the display) and puts them into a ring it shares with us. An
+ * event is three numbers: what kind, a code, a value.
+ *
+ * The host raises WASM_IRQ_INPUT when it has put events there, and the
+ * interrupt takes them at once (on IRQ_CPU, whose idle task waits for
+ * exactly that). A host that does not raise it (an older runtime) is still
+ * served: a kernel thread looks at the ring every 3 to 6 ms until the first
+ * interrupt has come, and after that only every 100 ms, in case one is ever
+ * lost.
+ *
+ * The pointer reports positions, not movements, like a tablet: the host
+ * knows where on the display the pointer is, scaled to 0..32767 both ways.
+ *
+ * A third device, "Wasm host", is the host's doorbell for programs: an event
+ * of kind WASM_INPUT_DOORBELL becomes EV_MSC/MSC_SERIAL with its code as the
+ * value. The page's window server (wlserver/) waits on it, so that what the
+ * page writes into its table (orders, frames shown, the clipboard) is seen
+ * at once instead of at the server's next turn.
+ */
+#include <linux/delay.h>
+#include <linux/init.h>
+#include <linux/input.h>
+#include <linux/interrupt.h>
+#include <linux/kthread.h>
+#include <linux/module.h>
+#include <linux/sched.h>
+#include <linux/spinlock.h>
+
+/* Copy up to `max` waiting events (three 32-bit words each) and return how many. */
+extern long wasm_driver_input_rx(u32 *events, size_t max);
+
+enum {
+	WASM_INPUT_KEY,		/* code: a KEY_ code; value: 1 pressed, 0 released */
+	WASM_INPUT_POSITION,	/* code: x; value: y */
+	WASM_INPUT_BUTTON,	/* code: a BTN_ code; value: 1 pressed, 0 released */
+	WASM_INPUT_WHEEL,	/* value: clicks, positive is up */
+	WASM_INPUT_RESERVED,	/* (4: taken by the suspend work) */
+	WASM_INPUT_DOORBELL,	/* code: what the host rang for (the program's business) */
+};
+
+#define WASM_INPUT_BATCH	32
+#define WASM_INPUT_RANGE	32767
+
+static struct input_dev *wasm_keyboard, *wasm_pointer, *wasm_host;
+static DEFINE_SPINLOCK(wasm_input_lock);
+static bool wasm_input_irq_seen;
+
+/* Everything that waits in the ring, now. From the interrupt and from the thread. */
+static void wasm_input_drain(void)
+{
+	static u32 events[WASM_INPUT_BATCH * 3];
+	unsigned long flags;
+	long n;
+
+	spin_lock_irqsave(&wasm_input_lock, flags);
+	do {
+		int keys = 0, pointer = 0, host = 0;
+
+		n = wasm_driver_input_rx(events, WASM_INPUT_BATCH);
+		for (long i = 0; i < n; i++) {
+			u32 kind = events[3 * i], code = events[3 * i + 1];
+			s32 value = (s32)events[3 * i + 2];
+
+			switch (kind) {
+			case WASM_INPUT_KEY:
+				input_report_key(wasm_keyboard, code, value);
+				keys = 1;
+				break;
+			case WASM_INPUT_POSITION:
+				input_report_abs(wasm_pointer, ABS_X, code);
+				input_report_abs(wasm_pointer, ABS_Y, value);
+				pointer = 1;
+				break;
+			case WASM_INPUT_BUTTON:
+				input_report_key(wasm_pointer, code, value);
+				pointer = 1;
+				break;
+			case WASM_INPUT_WHEEL:
+				input_report_rel(wasm_pointer, REL_WHEEL, value);
+				pointer = 1;
+				break;
+			case WASM_INPUT_DOORBELL:
+				input_event(wasm_host, EV_MSC, MSC_SERIAL, code);
+				host = 1;
+				break;
+			}
+		}
+		if (keys)
+			input_sync(wasm_keyboard);
+		if (pointer)
+			input_sync(wasm_pointer);
+		if (host)
+			input_sync(wasm_host);
+	} while (n == WASM_INPUT_BATCH);
+	spin_unlock_irqrestore(&wasm_input_lock, flags);
+}
+
+static irqreturn_t wasm_input_interrupt(int irq, void *dev_id)
+{
+	WRITE_ONCE(wasm_input_irq_seen, true);
+	wasm_input_drain();
+	return IRQ_HANDLED;
+}
+
+static int wasm_input_thread(void *unused)
+{
+	while (!kthread_should_stop()) {
+		wasm_input_drain();
+		if (READ_ONCE(wasm_input_irq_seen))
+			schedule_timeout_idle(HZ / 10);
+		else
+			usleep_range(3000, 6000);
+	}
+	return 0;
+}
+
+static int __init wasm_input_init(void)
+{
+	struct task_struct *thread;
+	int err;
+
+	wasm_keyboard = input_allocate_device();
+	wasm_pointer = input_allocate_device();
+	wasm_host = input_allocate_device();
+	if (!wasm_keyboard || !wasm_pointer || !wasm_host) {
+		err = -ENOMEM;
+		goto fail;
+	}
+
+	wasm_keyboard->name = "Wasm keyboard";
+	wasm_keyboard->id.bustype = BUS_VIRTUAL;
+	__set_bit(EV_KEY, wasm_keyboard->evbit);
+	__set_bit(EV_REP, wasm_keyboard->evbit);
+	for (int key = KEY_ESC; key < BTN_MISC; key++)
+		__set_bit(key, wasm_keyboard->keybit);
+
+	wasm_pointer->name = "Wasm pointer";
+	wasm_pointer->id.bustype = BUS_VIRTUAL;
+	input_set_capability(wasm_pointer, EV_KEY, BTN_LEFT);
+	input_set_capability(wasm_pointer, EV_KEY, BTN_RIGHT);
+	input_set_capability(wasm_pointer, EV_KEY, BTN_MIDDLE);
+	input_set_capability(wasm_pointer, EV_REL, REL_WHEEL);
+	input_set_abs_params(wasm_pointer, ABS_X, 0, WASM_INPUT_RANGE, 0, 0);
+	input_set_abs_params(wasm_pointer, ABS_Y, 0, WASM_INPUT_RANGE, 0, 0);
+
+	wasm_host->name = "Wasm host";
+	wasm_host->id.bustype = BUS_VIRTUAL;
+	input_set_capability(wasm_host, EV_MSC, MSC_SERIAL);
+
+	err = input_register_device(wasm_keyboard);
+	if (err)
+		goto fail;
+	err = input_register_device(wasm_pointer);
+	if (err) {
+		input_unregister_device(wasm_keyboard);
+		wasm_keyboard = NULL;
+		goto fail;
+	}
+	/* (After the other two: they stay event0 and event1.) */
+	err = input_register_device(wasm_host);
+	if (err) {
+		input_unregister_device(wasm_keyboard);
+		input_unregister_device(wasm_pointer);
+		wasm_keyboard = wasm_pointer = NULL;
+		goto fail;
+	}
+
+	err = request_irq(WASM_IRQ_INPUT, wasm_input_interrupt, 0, "wasm-input", NULL);
+	if (err)
+		pr_warn("wasm-input: no interrupt (%d): the ring is looked at every few ms\n", err);
+
+	thread = kthread_run(wasm_input_thread, NULL, "wasm-input");
+	return PTR_ERR_OR_ZERO(thread);
+
+fail:
+	input_free_device(wasm_keyboard);
+	input_free_device(wasm_pointer);
+	input_free_device(wasm_host);
+	return err;
+}
+device_initcall(wasm_input_init);
