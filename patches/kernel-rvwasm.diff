diff --git a/arch/wasm/include/asm/thread_info.h b/arch/wasm/include/asm/thread_info.h
index 4cf08ef85..cab3cb779 100644
--- a/arch/wasm/include/asm/thread_info.h
+++ b/arch/wasm/include/asm/thread_info.h
@@ -21,10 +21,24 @@
  * iX.const, iX.load, local.get, global.get	Wasm internal stack
  * lobal.set __stack_pointer			__stack_pointer managed stack
  *
- * One page should for this reason be enough for the kernel stack, even in the
- * case where one page is configured to be 4K.
+ * One page was thought to be enough for the kernel stack for this reason, even
+ * where a page is 4K. It is not: with a file system on a block device, the
+ * network stack and programs started through binfmt_misc, an ordinary execve()
+ * was measured to use 3.7K of the 4K, and deeper paths (memory reclaim from
+ * inside an allocation, interrupts taken on top of a system call) go past the
+ * end. Nothing stops a stack there: there is no MMU to put a guard page below
+ * it, so it runs on into whatever page lies below, which as often as not is the
+ * stack of the task created just before, and what lies at the top of that is
+ * that task's pt_regs: its saved cpuflags among them, which is how one task's
+ * deep system call became another task's "Syscall called when in kernel mode".
+ *
+ * Four pages; and the end of the stack is checked when a task leaves the
+ * kernel (traps.c) and when it gives up its CPU (CONFIG_SCHED_STACK_END_CHECK),
+ * so that an overrun is a panic that says so and not a corruption of memory
+ * that shows up somewhere else. CONFIG_DEBUG_STACK_USAGE reports the deepest
+ * use so far as tasks exit ("used greatest stack depth").
  */
-#define THREAD_SIZE_ORDER	(0)
+#define THREAD_SIZE_ORDER	(2)
 #define THREAD_SIZE		(PAGE_SIZE << THREAD_SIZE_ORDER)
 #define THREAD_MASK		(~(THREAD_SIZE - 1))
 
@@ -34,8 +48,18 @@ struct thread_info {
 	unsigned int		cpu;
 	int			preempt_count;	/* Needed but not really used */
 	int			instance_depth;	/* 0 = idle task, 1 = running */
+	int			pool;		/* a user task that shares the pool's CPUs (process.c) */
 	unsigned long		syscall_work;	/* SYSCALL_WORK_ flags */
 
+	/*
+	 * A task switch without a trip through the host's main thread
+	 * (process.c, wasm_task_switch_area()): the task that switches to us
+	 * writes where it came from into switch_from and sets switch_word, on
+	 * which our Worker waits. Both belong to the host's runtime.
+	 */
+	unsigned long		switch_from __aligned(8);
+	unsigned int		switch_word;
+
 	/* The kernel plays tricks like casting to atomic_long_t* for flags. */
 	unsigned long		flags __aligned(L1_CACHE_BYTES);
 };
