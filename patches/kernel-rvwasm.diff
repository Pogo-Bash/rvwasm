diff --git a/arch/wasm/kernel/cachecap.c b/arch/wasm/kernel/cachecap.c
new file mode 100644
index 000000000..3ecb2e214
--- /dev/null
+++ b/arch/wasm/kernel/cachecap.c
@@ -0,0 +1,74 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * A cap on the page cache.
+ *
+ * Linux keeps what it has read in memory for as long as nothing else wants
+ * the memory, so given time the cache grows into all of it. A real machine
+ * loses nothing by that. A Wasm memory does: every page the kernel touches
+ * once is memory the browser has given the machine for good (a Wasm memory
+ * never gives memory back), so a machine of 3 GiB that has read 3 GiB of
+ * files holds 3 GiB of the computer it runs on, whatever it is doing now.
+ *
+ * With a cap, a kernel thread looks every second at how much of the page
+ * cache could be let go (the file pages on the LRU lists: not ramfs, whose
+ * pages are the files themselves) and reclaims down to a little below the cap
+ * when there is more. The pages it frees are the ones the next allocations
+ * get, so what the machine touches stays near what its programs use plus the
+ * cap. "wasm_cache_max=MiB" on the command line, or
+ * /proc/sys/vm/wasm_cache_max_mb at run time; 0 is no cap.
+ */
+#include <linux/init.h>
+#include <linux/kthread.h>
+#include <linux/mm.h>
+#include <linux/sched.h>
+#include <linux/sysctl.h>
+#include <linux/vmstat.h>
+
+unsigned long wasm_reclaim_cache(unsigned long nr_to_reclaim);
+
+static unsigned int cache_max_mb;
+static unsigned long cache_reclaimed;	/* pages, since boot (for /proc/sys/vm/wasm_cache_reclaimed) */
+
+static int __init cache_max_setup(char *str)
+{
+	return kstrtouint(str, 0, &cache_max_mb) == 0;
+}
+__setup("wasm_cache_max=", cache_max_setup);
+
+static int cachecap_thread(void *unused)
+{
+	while (!kthread_should_stop()) {
+		unsigned long cap = (unsigned long)READ_ONCE(cache_max_mb) << (20 - PAGE_SHIFT);
+		unsigned long file = global_node_page_state(NR_ACTIVE_FILE) +
+				     global_node_page_state(NR_INACTIVE_FILE);
+
+		if (cap && file > cap)
+			cache_reclaimed += wasm_reclaim_cache(file - cap + cap / 16);
+		schedule_timeout_idle(HZ);
+	}
+	return 0;
+}
+
+static const struct ctl_table cachecap_table[] = {
+	{
+		.procname	= "wasm_cache_max_mb",
+		.data		= &cache_max_mb,
+		.maxlen		= sizeof(cache_max_mb),
+		.mode		= 0644,
+		.proc_handler	= proc_douintvec,
+	},
+	{
+		.procname	= "wasm_cache_reclaimed",
+		.data		= &cache_reclaimed,
+		.maxlen		= sizeof(cache_reclaimed),
+		.mode		= 0444,
+		.proc_handler	= proc_doulongvec_minmax,
+	},
+};
+
+static int __init cachecap_init(void)
+{
+	register_sysctl("vm", cachecap_table);
+	return PTR_ERR_OR_ZERO(kthread_run(cachecap_thread, NULL, "wasm-cachecap"));
+}
+late_initcall(cachecap_init);
