diff --git a/arch/wasm/configs/rvwasm.config b/arch/wasm/configs/rvwasm.config
new file mode 100644
index 000000000..77bb70191
--- /dev/null
+++ b/arch/wasm/configs/rvwasm.config
@@ -0,0 +1,64 @@
+# Help: Settings needed to run foreign (riscv64) binaries through a user-mode translator.
+
+CONFIG_BINFMT_MISC=y
+
+# Every emulated process has its own guest memory arena, which is one
+# contiguous allocation that is copied when it grows, and a guest fork doubles
+# it: give the machine 3 GiB (0xC000 Wasm pages) instead of 512 MiB.
+CONFIG_BOOT_MEM_PAGES=0xC000
+
+# Networking: TCP/IP, local sockets, and the interface the host provides.
+CONFIG_NET=y
+CONFIG_INET=y
+CONFIG_UNIX=y
+CONFIG_PACKET=y
+CONFIG_NETDEVICES=y
+CONFIG_WASM_NET=y
+
+# What distribution software takes for granted: file locks (apt and dpkg
+# lock their databases), inotify, System V IPC.
+CONFIG_FILE_LOCKING=y
+CONFIG_INOTIFY_USER=y
+CONFIG_SYSVIPC=y
+
+# A display and input: the frame buffer the host shows, the kernel's text
+# console on it, keyboard and pointer, and pseudo-terminals for terminal
+# emulators.
+CONFIG_FB=y
+CONFIG_FB_WASM=y
+CONFIG_VT=y
+CONFIG_VT_CONSOLE=y
+CONFIG_FRAMEBUFFER_CONSOLE=y
+CONFIG_INPUT=y
+CONFIG_INPUT_EVDEV=y
+CONFIG_INPUT_MISC=y
+CONFIG_INPUT_WASM=y
+CONFIG_UNIX98_PTYS=y
+
+# A disk: the block device the host provides, the file system for it, and
+# /dev kept by the kernel, so that devices need not be made by hand.
+CONFIG_BLK_DEV_WASM=y
+CONFIG_EXT4_FS=y
+CONFIG_DEVTMPFS=y
+
+# Namespaces: a process can be given its own view of process ids, users,
+# host name, IPC, network and mounts (what sandboxes and containers are made
+# of). None of it needs an MMU.
+CONFIG_NAMESPACES=y
+CONFIG_UTS_NS=y
+CONFIG_IPC_NS=y
+CONFIG_USER_NS=y
+CONFIG_PID_NS=y
+CONFIG_NET_NS=y
+
+# Kernel stacks have nothing below them that would stop an overrun (there is
+# no MMU): look at the end of a task's stack when it gives up its CPU, and
+# say how deep the deepest stack got as tasks exit.
+CONFIG_SCHED_STACK_END_CHECK=y
+CONFIG_DEBUG_STACK_USAGE=y
+
+# Timers to the microsecond, not to the tick (HZ=100: 10 ms). Without them
+# every nanosleep(), poll() or epoll_wait() with a timeout, and every
+# usleep_range() of a driver, rounded up to the next tick and then some: a
+# sleep of 1 ms took 9 ms on the median (probes/sched_bench.c sleep).
+CONFIG_HIGH_RES_TIMERS=y
