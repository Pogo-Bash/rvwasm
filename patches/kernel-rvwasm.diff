diff --git a/arch/wasm/kernel/process.c b/arch/wasm/kernel/process.c
index 2f7a4df6a..7f21f123c 100644
--- a/arch/wasm/kernel/process.c
+++ b/arch/wasm/kernel/process.c
@@ -1,6 +1,8 @@
 /* SPDX-License-Identifier: GPL-2.0-only */
 
+#include <linux/cpu.h>
 #include <linux/entry-common.h>
+#include <linux/mutex.h>
 #include <linux/ptrace.h>
 #include <linux/sched.h>
 #include <linux/sched/debug.h>
@@ -10,7 +12,104 @@
 #include <asm/entry.h>
 #include <asm/wasm.h>
 
+void wasm_flags_note_aux(int site, int aux);
+void wasm_check_current(const char *where);
+
+/*
+ * CPUs for user tasks.
+ *
+ * A task that runs Wasm code cannot be interrupted, so it cannot be made to
+ * share a CPU: a user task gets a CPU of its own, on which nothing else
+ * wants to run (user_cpus has the CPUs that are taken). That costs a CPU per
+ * task, with everything a CPU brings (on the host: a thread for it and one
+ * for each of its kernel threads), and there are only so many.
+ *
+ * A program can say that it makes a system call at least every millisecond
+ * or so, come what may: prctl(PR_WASM_COOPERATIVE). Such tasks share a small
+ * set of CPUs, the pool, among which the scheduler places and moves them
+ * like on any machine; they give way to each other whenever they are in the
+ * kernel, which is also when their CPU's interrupts are taken
+ * (wasm_poll_irqs()). The pool has as many CPUs as the "wasm_pool=" boot
+ * parameter says (none: there is no pool), brought up as tasks join. A task
+ * in the pool stays there, and so do the tasks it creates and the programs
+ * it executes.
+ */
 static cpumask_t user_cpus = CPU_MASK_NONE;
+static DEFINE_MUTEX(user_cpus_mutex);
+
+static cpumask_t pool_cpus = CPU_MASK_NONE;
+static unsigned int pool_size;
+static atomic_t pool_tasks = ATOMIC_INIT(0);
+
+static int __init wasm_pool_setup(char *str)
+{
+	get_option(&str, (int *)&pool_size);
+	return 1;
+}
+__setup("wasm_pool=", wasm_pool_setup);
+
+/* With user_cpus_mutex: one more CPU of the pool comes up if there are more tasks in it than CPUs. */
+static int pool_grow(void)
+{
+	unsigned int online = cpumask_weight_and(&pool_cpus, cpu_online_mask);
+	int cpu;
+
+	if (cpumask_empty(&pool_cpus)) {
+		/* The first time: which CPUs. From the top, away from the ones tasks get for themselves. */
+		for (cpu = nr_cpu_ids - 1; cpu >= 0 && cpumask_weight(&pool_cpus) < pool_size; cpu--) {
+			if (cpu == IRQ_CPU || !cpu_possible(cpu) || cpumask_test_cpu(cpu, &user_cpus))
+				continue;
+			cpumask_set_cpu(cpu, &pool_cpus);
+			cpumask_set_cpu(cpu, &user_cpus);
+		}
+		if (cpumask_empty(&pool_cpus))
+			return -EBUSY;
+	}
+	if (online && online >= (unsigned int)atomic_read(&pool_tasks))
+		return 0;
+	for_each_cpu(cpu, &pool_cpus) {
+		if (!cpu_online(cpu))
+			return cpu_device_up(get_cpu_device(cpu)) && !online ? -EBUSY : 0;
+	}
+	return 0;
+}
+
+/* prctl(PR_WASM_COOPERATIVE): the calling task promises system calls at short intervals and joins the pool. */
+int wasm_task_cooperative(void)
+{
+	struct thread_info *ti = current_thread_info();
+	unsigned int own_cpu;
+	int retval;
+
+	if (current->flags & PF_KTHREAD)
+		return -EINVAL;
+	if (ti->pool)
+		return 0;
+	if (!pool_size)
+		return -ENODEV;
+
+	mutex_lock(&user_cpus_mutex);
+	atomic_inc(&pool_tasks);
+	retval = pool_grow();
+	mutex_unlock(&user_cpus_mutex);
+	if (retval) {
+		atomic_dec(&pool_tasks);
+		return retval;
+	}
+
