new file mode 100644
index 000000000..9c205628c
--- /dev/null
+++ b/drivers/net/wasm_net.c
@@ -0,0 +1,166 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * A network interface for Linux/Wasm.
+ *
+ * Ethernet frames are handed to the Wasm host and taken from it; what the
+ * host does with them is its business (in a browser: a WebSocket to a relay
+ * that has a real network behind it).
+ *
+ * Frames the host has received wait in a ring on its side until a kernel
+ * thread takes them (the thread only exists while the interface is up). The
+ * host raises WASM_IRQ_NET when it has put a frame there, which wakes the
+ * thread at once; then the thread sleeps until the next one, looking anyway
+ * every 100 ms in case an interrupt is ever lost. A host that never raises
+ * it (an older runtime) gets the thread as it was before: it looks at short
+ * intervals while there is traffic, at longer ones when it has been quiet.
+ */
+#include <linux/delay.h>
+#include <linux/etherdevice.h>
+#include <linux/init.h>
+#include <linux/interrupt.h>
+#include <linux/kthread.h>
+#include <linux/netdevice.h>
+#include <linux/skbuff.h>
+
+/* Send one frame. */
+extern long wasm_driver_net_tx(const u8 *frame, size_t len);
+/* Copy the next received frame to buf and return its length, or 0 if there is none. */
+extern long wasm_driver_net_rx(u8 *buf, size_t size);
+
+#define WASM_NET_FRAME_MAX	1600	/* an MTU of 1500, the header, room to spare */
+#define WASM_NET_QUIET_AFTER	200	/* empty polls before the interval grows */
+
+struct wasm_net {
+	struct task_struct *rx_thread;
+	atomic_t rx_kick;		/* the interrupt came since the thread last looked */
+	bool rx_irq_seen;		/* it has come at all */
+	u8 rx_buf[WASM_NET_FRAME_MAX];
+};
+
+static netdev_tx_t wasm_net_xmit(struct sk_buff *skb, struct net_device *dev)
+{
+	/* (Both of these free the skb if they fail.) */
+	if (skb_linearize(skb)) {
+		dev_kfree_skb_any(skb);
+		dev->stats.tx_dropped++;
+		return NETDEV_TX_OK;
+	}
+	if (skb_put_padto(skb, ETH_ZLEN)) {
+		dev->stats.tx_dropped++;
+		return NETDEV_TX_OK;
+	}
+
+	wasm_driver_net_tx(skb->data, skb->len);
+	dev->stats.tx_packets++;
+	dev->stats.tx_bytes += skb->len;
+	dev_consume_skb_any(skb);
+	return NETDEV_TX_OK;
+}
+
+static int wasm_net_rx_thread(void *data)
+{
+	struct net_device *dev = data;
+	struct wasm_net *priv = netdev_priv(dev);
+	unsigned int quiet = 0;
+
+	while (!kthread_should_stop()) {
+		long len = wasm_driver_net_rx(priv->rx_buf, sizeof(priv->rx_buf));
+		struct sk_buff *skb;
+
+		if (len <= 0) {
+			if (READ_ONCE(priv->rx_irq_seen)) {
+				/* Until the host rings (or 100 ms). */
+				set_current_state(TASK_IDLE);
+				if (!atomic_xchg(&priv->rx_kick, 0) && !kthread_should_stop())
+					schedule_timeout(HZ / 10);
+				__set_current_state(TASK_RUNNING);
+			} else if (quiet < WASM_NET_QUIET_AFTER) {
+				quiet++;
+				usleep_range(200, 400);
+			} else {
+				usleep_range(4000, 8000);
+			}
+			continue;
+		}
+		quiet = 0;
+
+		skb = netdev_alloc_skb_ip_align(dev, len);
+		if (!skb) {
+			dev->stats.rx_dropped++;
+			continue;
+		}
+		skb_put_data(skb, priv->rx_buf, len);
+		skb->protocol = eth_type_trans(skb, dev);
+		dev->stats.rx_packets++;
+		dev->stats.rx_bytes += len;
+		netif_rx(skb);
+	}
+	return 0;
+}
+
+static irqreturn_t wasm_net_interrupt(int irq, void *dev_id)
+{
+	struct net_device *dev = dev_id;
+	struct wasm_net *priv = netdev_priv(dev);
+	struct task_struct *thread = READ_ONCE(priv->rx_thread);
+
+	WRITE_ONCE(priv->rx_irq_seen, true);
+	atomic_set(&priv->rx_kick, 1);
+	if (thread && !IS_ERR(thread))
+		wake_up_process(thread);
+	return IRQ_HANDLED;
+}
+
+static int wasm_net_open(struct net_device *dev)
+{
+	struct wasm_net *priv = netdev_priv(dev);
+
+	priv->rx_thread = kthread_run(wasm_net_rx_thread, dev, "%s-rx", dev->name);
+	if (IS_ERR(priv->rx_thread))
+		return PTR_ERR(priv->rx_thread);
+	netif_carrier_on(dev);
+	netif_start_queue(dev);
+	return 0;
+}
+
+static int wasm_net_stop(struct net_device *dev)
+{
+	struct wasm_net *priv = netdev_priv(dev);
+	struct task_struct *thread = priv->rx_thread;
+
+	netif_stop_queue(dev);
+	netif_carrier_off(dev);
+	/* (The interrupt wakes the thread: not once it is gone.) */
+	WRITE_ONCE(priv->rx_thread, NULL);
+	synchronize_irq(WASM_IRQ_NET);
+	kthread_stop(thread);
+	return 0;
+}
+
+static const struct net_device_ops wasm_net_ops = {
+	.ndo_open		= wasm_net_open,
+	.ndo_stop		= wasm_net_stop,
+	.ndo_start_xmit		= wasm_net_xmit,
+	.ndo_validate_addr	= eth_validate_addr,
+	.ndo_set_mac_address	= eth_mac_addr,
+};
+
+static int __init wasm_net_init(void)
+{
+	struct net_device *dev = alloc_etherdev(sizeof(struct wasm_net));
+	int err;
+
+	if (!dev)
+		return -ENOMEM;
+	dev->netdev_ops = &wasm_net_ops;
+	eth_hw_addr_random(dev);
+	err = register_netdev(dev);
+	if (err) {
+		free_netdev(dev);
+		return err;
+	}
+	if (request_irq(WASM_IRQ_NET, wasm_net_interrupt, 0, "wasm-net", dev))
+		pr_warn("wasm-net: no interrupt: received frames are looked for at intervals\n");
+	return 0;
+}
+device_initcall(wasm_net_init);
