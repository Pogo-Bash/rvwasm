diff --git a/arch/wasm/include/asm/syscall_wrapper.h b/arch/wasm/include/asm/syscall_wrapper.h
new file mode 100644
index 000000000..b962ac5c7
--- /dev/null
+++ b/arch/wasm/include/asm/syscall_wrapper.h
@@ -0,0 +1,64 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * System call wrappers taking pt_regs.
+ *
+ * On Wasm a function can only be called with exactly the signature it was
+ * defined with: an indirect call with the wrong number of arguments traps.
+ * User space decides how many arguments it passes, and it is common for a
+ * libc to pass fewer than the kernel prototype has (or more), which other
+ * architectures tolerate because the extra registers are simply ignored.
+ * Calling the handlers through the raw syscall table therefore let any
+ * program trap the kernel.
+ *
+ * With these wrappers every entry in the syscall table has one and the same
+ * signature and picks its own arguments out of pt_regs, as on other
+ * architectures that select ARCH_HAS_SYSCALL_WRAPPER.
+ */
+#ifndef _ASM_WASM_SYSCALL_WRAPPER_H
+#define _ASM_WASM_SYSCALL_WRAPPER_H
+
+#include <asm/ptrace.h>
+
+asmlinkage long __wasm_sys_ni_syscall(const struct pt_regs *);
+
+#define __SYSCALL_SE_DEFINEx(x, prefix, name, ...)					\
+	static long __se_##prefix##name(__MAP(x,__SC_LONG,__VA_ARGS__));		\
+	static long __se_##prefix##name(__MAP(x,__SC_LONG,__VA_ARGS__))
+
+#define SC_WASM_REGS_TO_ARGS(x, ...)							\
+	__MAP(x,__SC_ARGS								\
+	      ,,regs->syscall_args[0],,regs->syscall_args[1]				\
+	      ,,regs->syscall_args[2],,regs->syscall_args[3]				\
+	      ,,regs->syscall_args[4],,regs->syscall_args[5])
+
+#define __SYSCALL_DEFINEx(x, name, ...)						\
+	asmlinkage long __wasm_sys##name(const struct pt_regs *regs);		\
+	ALLOW_ERROR_INJECTION(__wasm_sys##name, ERRNO);				\
+	static inline long __do_sys##name(__MAP(x,__SC_DECL,__VA_ARGS__));	\
+	__SYSCALL_SE_DEFINEx(x, sys, name, __VA_ARGS__)				\
+	{									\
+		long ret = __do_sys##name(__MAP(x,__SC_CAST,__VA_ARGS__));	\
+		__MAP(x,__SC_TEST,__VA_ARGS__);					\
+		__PROTECT(x, ret,__MAP(x,__SC_ARGS,__VA_ARGS__));		\
+		return ret;							\
+	}									\
+	asmlinkage long __wasm_sys##name(const struct pt_regs *regs)		\
+	{									\
+		return __se_sys##name(SC_WASM_REGS_TO_ARGS(x,__VA_ARGS__));	\
+	}									\
+	static inline long __do_sys##name(__MAP(x,__SC_DECL,__VA_ARGS__))
+
+#define SYSCALL_DEFINE0(sname)							\
+	SYSCALL_METADATA(_##sname, 0);						\
+	asmlinkage long __wasm_sys_##sname(const struct pt_regs *__unused);	\
+	ALLOW_ERROR_INJECTION(__wasm_sys_##sname, ERRNO);			\
+	asmlinkage long __wasm_sys_##sname(const struct pt_regs *__unused)
+
+#define COND_SYSCALL(name)							\
+	asmlinkage long __weak __wasm_sys_##name(const struct pt_regs *regs);	\
+	asmlinkage long __weak __wasm_sys_##name(const struct pt_regs *regs)	\
+	{									\
+		return sys_ni_syscall();					\
+	}
+
+#endif /* _ASM_WASM_SYSCALL_WRAPPER_H */
