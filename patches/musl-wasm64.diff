diff --git a/src/env/wasm/__main_argc_argv.c b/src/env/wasm/__main_argc_argv.c
new file mode 100644
index 0000000..6eb4946
--- /dev/null
+++ b/src/env/wasm/__main_argc_argv.c
@@ -0,0 +1,13 @@
+/*
+ * The main crt1 calls (arch/wasm/crt_arch.h), for a program whose main takes no
+ * arguments: clang names that one __main_void on Wasm. Taken from the library
+ * only when the program has no __main_argc_argv, a main(int, char **), itself.
+ */
+int __main_void(void);
+
+int __main_argc_argv(int argc, char *argv[])
+{
+	(void)argc;
+	(void)argv;
+	return __main_void();
+}
