diff --git a/src/process/wasm/_Fork.c b/src/process/wasm/_Fork.c
new file mode 100644
index 0000000..587760f
--- /dev/null
+++ b/src/process/wasm/_Fork.c
@@ -0,0 +1,40 @@
+#include <unistd.h>
+#include <errno.h>
+#include "syscall.h"
+#include "libc.h"
+#include "lock.h"
+#include "pthread_impl.h"
+#include "aio_impl.h"
+#include "fork_impl.h"
+
+static void dummy(int x) { }
+weak_alias(dummy, __aio_atfork);
+
+void __post_Fork(int ret)
+{
+	if (!ret) {
+		pthread_t self = __pthread_self();
+		self->tid = __syscall(SYS_set_tid_address, &__thread_list_lock);
+		self->robust_list.off = 0;
+		self->robust_list.pending = 0;
+		self->next = self->prev = self;
+		__thread_list_lock = 0;
+		libc.threads_minus_1 = 0;
+		if (libc.need_locks) libc.need_locks = -1;
+	}
+	UNLOCK(__abort_lock);
+	if (!ret) __aio_atfork(1);
+}
+
+/*
+ * Without an MMU there is no copy of the parent's memory to give a child, and
+ * on Wasm nowhere in it for the child to return to either: a new task runs
+ * the C library's clone callback, with a function and its stack. fork()
+ * fails, as on other systems without an MMU (the kernel refuses such a clone
+ * as well), so that a program can take another way: posix_spawn(), or clone()
+ * with a function.
+ */
+pid_t _Fork(void)
+{
+	return __syscall_ret(-ENOSYS);
+}
