+    // nativeqt: a static program has its workers as static plugins (also in Qt's list of them, by their
+    // IID org.kde.kio.worker.NAME): run in a thread of the program, as kio_file always is, there being no
+    // plugin file for kioworker to load.
+    {
+        const QString iid = QLatin1String("org.kde.kio.worker.") + QFileInfo(_name).fileName().remove(QLatin1String("kio_"));
+        const auto statics = QPluginLoader::staticPlugins();
+        for (const QStaticPlugin &plugin : statics) {
+            if (plugin.metaData().value(QLatin1String("IID")).toString() != iid) {
+                continue;
+            }
+            auto *factory = qobject_cast<WorkerFactory *>(plugin.instance());
+            if (!factory) {
+                error_text = i18n("The KIO worker for protocol '%1' cannot run in this program's threads.", protocol);
+                error = KIO::ERR_CANNOT_CREATE_WORKER;
+                return nullptr;
+            }
+            auto *worker = new Worker(protocol);
+            const QUrl workerAddress = worker->m_workerConnServer->address();
+            if (workerAddress.isEmpty()) {
+                error_text = i18n("Can not create a socket for launching a KIO worker for protocol '%1'.", protocol);
+                error = KIO::ERR_CANNOT_CREATE_WORKER;
+                delete worker;
+                return nullptr;
+            }
+            auto *thread = new WorkerThread(worker, factory, workerAddress.toString().toLocal8Bit());
+            thread->start();
+            worker->setWorkerThread(thread);
+            return worker;
+        }
+    }
+
