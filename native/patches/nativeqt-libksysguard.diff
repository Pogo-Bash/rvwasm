--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -121,6 +121,24 @@
     ${CMAKE_CURRENT_BINARY_DIR}/KSysGuardConfigVersion.cmake
     DESTINATION ${CMAKECONFIG_INSTALL_DIR})
 
+# nativeqt: static libraries carry what they link into their users: the resource objects of the QML modules
+# (*_resources_N) and SystemStats' D-Bus interface library go into the export set with them.
+if(NOT BUILD_SHARED_LIBS)
+    function(_nq_ksg_objects dir)
+        get_property(_targets DIRECTORY ${dir} PROPERTY BUILDSYSTEM_TARGETS)
+        foreach(_t IN LISTS _targets)
+            if(_t MATCHES "_resources_[0-9]+$" OR _t STREQUAL "dbusinterface")
+                install(TARGETS ${_t} EXPORT libksysguardLibraryTargets ${KDE_INSTALL_TARGETS_DEFAULT_ARGS}
+                    OBJECTS DESTINATION ${KDE_INSTALL_LIBDIR}/objects/${_t})
+            endif()
+        endforeach()
+        get_property(_subdirs DIRECTORY ${dir} PROPERTY SUBDIRECTORIES)
+        foreach(_d IN LISTS _subdirs)
+            _nq_ksg_objects(${_d})
+        endforeach()
+    endfunction()
+    _nq_ksg_objects(${CMAKE_CURRENT_SOURCE_DIR})
+endif()
 install(EXPORT libksysguardLibraryTargets
         NAMESPACE KSysGuard::
         DESTINATION ${CMAKECONFIG_INSTALL_DIR}
