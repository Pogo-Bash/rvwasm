+#ifdef WL_NO_FFI
+void
+wl_closure_invoke(struct wl_closure *closure, uint32_t flags,
+		  struct wl_object *target, uint32_t opcode, void *data)
+{
+	int i, count;
+	unsigned key;
+	uint64_t a[WL_CLOSURE_MAX_ARGS];
+	const char *sig_iter;
+	struct argument_details arg;
+	void (* const *implementation)(void);
+
+	count = arg_count_for_signature(closure->message->signature);
+	if (count > WL_NOFFI_MAX)
+		wl_abort("listener function for opcode %u of %s has too many arguments\n",
+			 opcode, target->interface->name);
+	key = 1u << count;
+	sig_iter = closure->message->signature;
+	for (i = 0; i < count; i++) {
+		union wl_argument *v = &closure->args[i];
+		sig_iter = get_next_argument(sig_iter, &arg);
+		switch (arg.type) {
+		case WL_ARG_INT: a[i] = (uint32_t)v->i; break;
+		case WL_ARG_UINT: a[i] = v->u; break;
+		case WL_ARG_FIXED: a[i] = (uint32_t)v->f; break;
+		case WL_ARG_FD: a[i] = (uint32_t)v->h; break;
+		case WL_ARG_STRING: a[i] = (uintptr_t)v->s; key |= 1u << i; break;
+		case WL_ARG_OBJECT: a[i] = (uintptr_t)v->o; key |= 1u << i; break;
+		case WL_ARG_ARRAY: a[i] = (uintptr_t)v->a; key |= 1u << i; break;
+		case WL_ARG_NEW_ID:
+			if (flags & WL_CLOSURE_INVOKE_CLIENT) {
+				a[i] = (uintptr_t)v->o;
+				key |= 1u << i;
+			} else {
+				a[i] = v->n;
+			}
+			break;
+		default:
+			wl_abort("unknown type\n");
+		}
+	}
+
+	implementation = target->implementation;
+	if (!implementation[opcode]) {
+		wl_abort("listener function for opcode %u of %s is NULL\n",
+			 opcode, target->interface->name);
+	}
+	wl_noffi_call(implementation[opcode], data, target, key, a);
+
+	wl_closure_clear_fds(closure);
+}
+#else
 void
 wl_closure_invoke(struct wl_closure *closure, uint32_t flags,
 		  struct wl_object *target, uint32_t opcode, void *data)
@@ -1229,6 +1290,7 @@ wl_closure_invoke(struct wl_closure *closure, uint32_t flags,
 
