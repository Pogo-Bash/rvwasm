# nativeqt: the parts of plasma-workspace besides libkworkspace and the shell that plasmashell links (what
# Debian's Plasma loads at start-up, and the panel's applets), included after add_subdirectory(shell) by
# plasma-shell-only.py.
include(${NQ_CMAKE_DIR}/nq-plugins.cmake)
foreach(_x org.kde.kded6.xml:KDED_DBUS_INTERFACE kf6_org.freedesktop.ScreenSaver.xml:SCREENSAVER_DBUS_INTERFACE)
    string(REPLACE ":" ";" _x ${_x})
    list(GET _x 0 _f)
    list(GET _x 1 _v)
    if(NOT ${_v})
        set(${_v} ${CMAKE_CURRENT_SOURCE_DIR}/nativeqt-dbus/${_f})
    endif()
endforeach()
add_subdirectory(components/containmentlayoutmanager)
add_subdirectory(wallpapers/image/plugin)
nq_old_qml_plugin(plasma_wallpaper_imageplugin org.kde.plasma.wallpapers.image ImagePlugin
    ${CMAKE_CURRENT_SOURCE_DIR}/wallpapers/image/plugin/qmldir)
add_subdirectory(containmentactions/contextmenu)
add_subdirectory(containmentactions/paste)
add_subdirectory(kioworkers/desktop)
add_subdirectory(libtaskmanager)
add_subdirectory(libnotificationmanager)
add_subdirectory(components/dbus)
add_subdirectory(components/calendar)
add_subdirectory(components/trianglemousefilter)
# the task manager's media controls (org.kde.plasma.private.mpris)
add_subdirectory(libkmpris)
# Kickoff's (and KRunner's) search of the applications
add_subdirectory(runners/services)
# the digital clock's time (a Plasma5Support data engine; dataengines/CMakeLists.txt's definitions for it)
remove_definitions(-DQT_NO_CAST_FROM_ASCII -DQT_NO_CAST_TO_ASCII -DQT_NO_CAST_FROM_BYTEARRAY)
add_subdirectory(dataengines/time)
add_definitions(-DQT_NO_CAST_FROM_ASCII -DQT_NO_CAST_TO_ASCII -DQT_NO_CAST_FROM_BYTEARRAY)
add_subdirectory(applets/digital-clock)
add_subdirectory(applets/kicker)
nq_old_qml_plugin(kickerplugin org.kde.plasma.private.kicker KickerPlugin ${CMAKE_CURRENT_SOURCE_DIR}/applets/kicker/plugin/qmldir)
# the system tray: its applet and container, and the DBusMenu importer it uses (that one's test left out)
add_subdirectory(libdbusmenuqt EXCLUDE_FROM_ALL)
# (KStatusNotifierItem carries its own copy of the DBusMenu types: these are renamed, for everything that uses them)
target_compile_definitions(dbusmenuqt PUBLIC DBusMenuItem=PwDBusMenuItem DBusMenuItemKeys=PwDBusMenuItemKeys
    DBusMenuLayoutItem=PwDBusMenuLayoutItem DBusMenuTypes_register=PwDBusMenuTypes_register)
add_subdirectory(applets/systemtray)
# (systemtraymodel.cpp is in both systemtraymodel_static and the QML plugin: once is enough in one binary)
get_target_property(_nq_src systemtrayplugin SOURCES)
list(REMOVE_ITEM _nq_src systemtraymodel.cpp)
set_property(TARGET systemtrayplugin PROPERTY SOURCES ${_nq_src})
target_link_libraries(systemtrayplugin PRIVATE systemtraymodel_static)
# The tray's applets whose parts this build has not (the keyboard layout's KCM module and KWin's virtual keyboard
# interface, Klipper's Prison, KPipeWire) are not offered (plasma-shell-only.py: PlasmoidRegistry), instead of
# showing an error; the notifications applet and the device notifier's plugin (plasma-desktop-parts) are built.
set(_nq_tray_unavailable org.kde.plasma.cameraindicator)
if(NOT TARGET KF6::Prison)
    list(APPEND _nq_tray_unavailable org.kde.plasma.clipboard)
endif()
if(NOT NQ_KCM_KEYBOARD)
    list(APPEND _nq_tray_unavailable org.kde.plasma.keyboardlayout)
endif()
string(REPLACE ";" "," _nq_tray_unavailable "${_nq_tray_unavailable}")
target_compile_definitions(systemtray_static PRIVATE NQ_TRAY_UNAVAILABLE="${_nq_tray_unavailable}")
add_subdirectory(applets/notifications)
# The rest of what Debian's plasmashell loads of plasma-workspace (the C++ halves of its applets, its QML modules,
# containment actions, data engines and runners): other layouts (a global theme's) and store widgets use them.
add_subdirectory(applets/panelspacer)
add_subdirectory(applets/icon)
add_subdirectory(applets/appmenu)
nq_old_qml_plugin(appmenuplugin org.kde.plasma.private.appmenu AppmenuPlugin ${CMAKE_CURRENT_SOURCE_DIR}/applets/appmenu/plugin/qmldir)
add_subdirectory(applets/keyboardindicator)
add_subdirectory(applets/mediacontroller)
nq_old_qml_plugin(mediacontrollerplugin org.kde.plasma.private.mediacontroller MediaControllerPlugin
    ${CMAKE_CURRENT_SOURCE_DIR}/applets/mediacontroller/plugin/qmldir)
if(TARGET KSysGuard::SensorFaces)
    add_subdirectory(applets/systemmonitor)
endif()
add_subdirectory(components/sessionsprivate)
add_subdirectory(components/shellprivate)
add_subdirectory(components/lookandfeelqml)
nq_old_qml_plugin(lookandfeelqmlplugin org.kde.plasma.lookandfeel SessionsPrivatePlugin ${CMAKE_CURRENT_SOURCE_DIR}/components/lookandfeelqml/qmldir)
add_subdirectory(components/batterycontrol)
add_subdirectory(components/workspace)
# (KWin's virtual keyboard interface: made from KWin's source, plasma-shell-patch in native/run/overnight.sh)
if(NOT KWIN_VIRTUALKEYBOARD_INTERFACE AND EXISTS ${CMAKE_CURRENT_SOURCE_DIR}/nativeqt-dbus/org.kde.kwin.VirtualKeyboard.xml)
    set(KWIN_VIRTUALKEYBOARD_INTERFACE ${CMAKE_CURRENT_SOURCE_DIR}/nativeqt-dbus/org.kde.kwin.VirtualKeyboard.xml)
endif()
if(KWIN_VIRTUALKEYBOARD_INTERFACE)
    add_subdirectory(components/keyboardlayout)
    nq_old_qml_plugin(keyboardlayoutplugin org.kde.plasma.workspace.keyboardlayout KeyboardLayoutPlugin
        ${CMAKE_CURRENT_SOURCE_DIR}/components/keyboardlayout/qmldir)
endif()
# (what the full build adds, native/run/full-build.sh: night light's library with Qt Positioning, Klipper with
# Prison, the notifications engine with KNotifyConfig)
if(TARGET Qt6::Positioning)
    add_subdirectory(libcolorcorrect)
endif()
if(TARGET KF6::Prison)
    add_subdirectory(klipper)
    # (its clipboard engine defines Klipper's logging category again: one static binary)
    target_compile_definitions(plasma_engine_clipboard PRIVATE KLIPPER_LOG=KLIPPER_ENGINE_LOG)
endif()
foreach(_a switchdesktop switchactivity switchwindow applauncher)
    add_subdirectory(containmentactions/${_a})
endforeach()
# (the application launcher action's AppLauncher and the folder view's (plasma-desktop) share a name)
target_compile_definitions(plasma_containmentactions_applauncher PRIVATE AppLauncher=AppLauncherContainmentAction)
remove_definitions(-DQT_NO_CAST_FROM_ASCII -DQT_NO_CAST_TO_ASCII -DQT_NO_CAST_FROM_BYTEARRAY)
set(_nq_engines applicationjobs executable)
if(TARGET KF6::NotifyConfig)
    list(APPEND _nq_engines notifications)
endif()
foreach(_e IN LISTS _nq_engines)
    add_subdirectory(dataengines/${_e})
endforeach()
add_definitions(-DQT_NO_CAST_FROM_ASCII -DQT_NO_CAST_TO_ASCII -DQT_NO_CAST_FROM_BYTEARRAY)
foreach(_r locations places sessions shell kill webshortcuts recentdocuments)
    add_subdirectory(runners/${_r})
endforeach()
# kicker's WindowSystem and KWindowSystem's Wayland plugin's share a name; in one static binary they collide
# (QML registers it by an explicit name, "WindowSystem", so the C++ name is free).
target_compile_definitions(kickerplugin PRIVATE WindowSystem=KickerWindowSystem)
# (static libtaskmanager's and libnotificationmanager's resources are object libraries their exports must carry)
set(_nq_exports libtaskmanager:libtaskmanagerLibraryTargets libnotificationmanager:notificationmanagerLibraryTargets)
if(TARGET colorcorrect)
    list(APPEND _nq_exports libcolorcorrect:libcolorcorrectLibraryTargets)
endif()
foreach(_d IN LISTS _nq_exports)
    string(REPLACE ":" ";" _d ${_d})
    list(GET _d 0 _dir)
    list(GET _d 1 _export)
    get_property(_nq_t DIRECTORY ${_dir} PROPERTY BUILDSYSTEM_TARGETS)
    foreach(_t IN LISTS _nq_t)
        if(_t MATCHES "_resources_[0-9]+$")
            install(TARGETS ${_t} EXPORT ${_export} OBJECTS DESTINATION ${KDE_INSTALL_LIBDIR}/objects/${_t})
        endif()
    endforeach()
endforeach()
