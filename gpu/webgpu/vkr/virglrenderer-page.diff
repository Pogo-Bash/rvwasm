--- /dev/null
+++ b/src/venus/vkr_guest.h
@@ -0,0 +1,45 @@
+/*
+ * rvgpu (rvwasm): vkr in a browser page, on wgvk (Vulkan on WebGPU).
+ * SPDX-License-Identifier: MIT
+ *
+ * The guest's shared memory (venus rings, reply streams, command streams, mapped device memory) is not this
+ * process's memory there: it is the machine's WebAssembly.Memory, which C cannot point into. A shm resource
+ * therefore carries a guest address (vkr_resource.guest), and every access goes through these functions
+ * (rvgpu.h; in the page they copy through JavaScript, natively they work on a host block). Nothing in vkr
+ * keeps a pointer into a resource.
+ */
+#ifndef VKR_GUEST_H
+#define VKR_GUEST_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+uint32_t rvgpu_guest_load32(uint64_t addr);
+void rvgpu_guest_store32(uint64_t addr, uint32_t v);
+void rvgpu_guest_read(void *dst, uint64_t addr, size_t len);
+void rvgpu_guest_write(uint64_t addr, const void *src, size_t len);
+
+/* The process has no threads for vkr: what vkr's ring, ring monitor and queue threads did is done by
+ * vkr_renderer_poll (vkr_renderer.h), from rvgpu's ring loop. */
+uint64_t vkr_now_ns(void);
+
+/* commands the rings ran, the time they took (decoding and the driver's calls), their bytes, and the
+ * commands inside command streams they executed (vkExecuteCommandStreamsMESA: recorded command buffers) */
+extern struct vkr_ring_stats { uint64_t cmds, ns, bytes, nested; } vkr_ring_stats;
+
+/* rvgpu's debugging words (rvgpu.h): [0] the venus command type being run + 1 (0: none), [1] 1 on a ring,
+ * 2 in a command stream, [3] commands run; the page reads them when the executor stops moving */
+extern uint32_t rvgpu_debug_words[8];
+
+static inline void
+vkr_debug_cmd(const void *cur, uint32_t where)
+{
+   uint32_t type;
+   memcpy(&type, cur, 4);
+   rvgpu_debug_words[0] = type + 1;
+   rvgpu_debug_words[1] = where;
+   rvgpu_debug_words[3]++;
+}
+
+#endif /* VKR_GUEST_H */
