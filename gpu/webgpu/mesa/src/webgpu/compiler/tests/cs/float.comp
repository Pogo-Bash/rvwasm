#version 450
// Float operations on special values (zeros, NaN-free infinities, denormals, halves), packing.
layout(local_size_x = 64) in;
layout(set = 0, binding = 1) buffer O { uint o[]; };
layout(set = 0, binding = 2) buffer I { uint inp[]; };
layout(set = 0, binding = 3) buffer O2 { uint o2[]; };
uint f(float v) { return floatBitsToUint(v); }
void main()
{
	uint i = gl_GlobalInvocationID.x;
	float x = uintBitsToFloat(inp[i]), y = uintBitsToFloat(inp[(i * 5u + 1u) % 1024u]);
	if (isnan(x)) x = 3.0;
	if (isnan(y)) y = -7.25;
	float cx = clamp(x, -1000.0, 1000.0), cy = clamp(y, -1000.0, 1000.0);
	uint base = i * 16u;
	o[base + 0] = cy != 0.0 ? f(mod(cx, cy)) : 0u;
	o[base + 1] = f(fract(cx));
	o[base + 2] = f(roundEven(x));
	o[base + 3] = f(trunc(x));
	o[base + 4] = f(floor(x));
	o[base + 5] = f(ceil(x));
	o[base + 6] = f(sign(x));
	o[base + 7] = f(abs(x));
	o[base + 8] = f(min(x, y));
	o[base + 9] = f(max(x, y));
	o[base + 10] = f(clamp(x, -1.0, 1.0));
	o[base + 11] = f(fma(cx, cy, 1.0));
	o[base + 12] = packHalf2x16(vec2(cx, cy));
	o[base + 13] = packUnorm4x8(vec4(x, y, 0.5, -0.5));
	o[base + 14] = packSnorm2x16(vec2(clamp(x, -2.0, 2.0), y));
	o[base + 15] = f(unpackHalf2x16(inp[i]).x) ^ f(unpackHalf2x16(inp[i]).y);
	o2[base + 0] = f(ldexp(cx, int(i % 20u) - 10));
	int e;
	float m = frexp(cx, e);
	o2[base + 1] = f(m) ^ uint(e);
	o2[base + 2] = uint(isinf(x)) | uint(isinf(y)) << 1;
	o2[base + 3] = uint(int(cx)) ^ uint(cx < 0.0 ? 0u : uint(cx));
	o2[base + 4] = f(sqrt(abs(cx)));
	o2[base + 5] = f(inversesqrt(abs(cx) + 1.0));
	o2[base + 6] = f(exp2(clamp(x, -10.0, 10.0)));
	o2[base + 7] = f(log2(abs(cx) + 1.0));
	o2[base + 8] = f(float(int(inp[i])) + float(inp[i]));
	o2[base + 9] = f(mix(cx, cy, 0.25));
	o2[base + 10] = f(step(x, y) + smoothstep(-1.0, 1.0, cx));
	o2[base + 11] = f(dot(vec3(cx, cy, 1.0), vec3(cy, 2.0, cx)));
	o2[base + 12] = f(length(vec2(cx, cy)));
	o2[base + 13] = f(cx / (cy == 0.0 ? 1.0 : cy));
	o2[base + 14] = packUnorm2x16(vec2(x, y)) ^ packSnorm4x8(vec4(x, y, -0.25, 0.75));
	o2[base + 15] = f(unpackUnorm4x8(inp[i]).z + unpackSnorm2x16(inp[i]).y);
}
