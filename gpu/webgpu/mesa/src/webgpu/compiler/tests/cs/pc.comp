#version 450
// Push constants (WebGPU immediates, at most 64 bytes, constant offsets).
layout(local_size_x = 64) in;
layout(push_constant) uniform PC { uint a; uint b; vec2 f; uvec4 c; ivec2 d; } pc;
layout(set = 0, binding = 1) buffer O { uint o[]; };
void main()
{
	uint i = gl_GlobalInvocationID.x;
	o[i * 4u + 0u] = pc.a + pc.b * i;
	o[i * 4u + 1u] = floatBitsToUint(pc.f.y * float(i)) ^ pc.c.z;
	o[i * 4u + 2u] = uint(pc.d.x - pc.d.y) + pc.c.w;
	o[i * 4u + 3u] = pc.c.x * pc.c.y;
}
