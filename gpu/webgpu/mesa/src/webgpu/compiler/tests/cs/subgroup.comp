#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_shader_subgroup_vote : require
// Subgroup operations (results depend on the subgroup size; both runs use the same device).
layout(local_size_x = 64) in;
layout(set = 0, binding = 1) buffer O { uint o[]; };
layout(set = 0, binding = 2) buffer I { uint inp[]; };
layout(set = 0, binding = 3) buffer O2 { uint o2[]; };
void main()
{
	uint i = gl_GlobalInvocationID.x;
	uint v = inp[i] & 0xffffu;
	o[i * 8u + 0u] = subgroupAdd(v);
	o[i * 8u + 1u] = subgroupMax(v);
	o[i * 8u + 2u] = subgroupBroadcastFirst(v);
	o[i * 8u + 3u] = subgroupShuffleXor(v, 1u);
	o[i * 8u + 4u] = subgroupBallot((v & 1u) != 0u).x;
	o[i * 8u + 5u] = uint(subgroupAny(v == 7u)) | uint(subgroupAll(v < 70000u)) << 1;
	o[i * 8u + 6u] = subgroupInclusiveAdd(v);
	o[i * 8u + 7u] = gl_SubgroupInvocationID + gl_SubgroupSize * 100u;
	uvec4 b = subgroupBallot((v % 3u) == 0u);
	o2[i * 8u + 0u] = subgroupBallotBitCount(b);
	o2[i * 8u + 1u] = subgroupBallotInclusiveBitCount(b);
	o2[i * 8u + 2u] = subgroupBallotExclusiveBitCount(b);
	o2[i * 8u + 3u] = subgroupBallotFindLSB(b);
	o2[i * 8u + 4u] = subgroupBallotFindMSB(b);
	o2[i * 8u + 5u] = uint(subgroupBallotBitExtract(b, (v >> 3) & 31u));
	o2[i * 8u + 6u] = subgroupExclusiveAdd(v) ^ subgroupMin(v) ^ subgroupAnd(v | 0x100u);
	o2[i * 8u + 7u] = uint(subgroupElect()) + uint(subgroupAllEqual(v & 0x10000u)) * 2u;
}
