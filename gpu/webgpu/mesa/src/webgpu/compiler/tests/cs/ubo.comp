#version 450
// Uniform buffer layouts: std140 arrays (16-byte stride), vec3 + float packing, matrices, dynamic indexing.
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std140) uniform U {
	float f4[4];
	vec3 v3;
	float w;
	mat3 m;
	uvec2 u2;
	ivec4 iv[2];
};
layout(set = 0, binding = 1) buffer O { uint o[]; };
layout(set = 0, binding = 2, std430) readonly buffer I { uint inp[]; };
void main()
{
	uint i = gl_GlobalInvocationID.x;
	uint k = inp[i] & 3u;
	o[i * 8u + 0u] = floatBitsToUint(f4[k]);
	o[i * 8u + 1u] = floatBitsToUint(v3[k % 3u]) ^ floatBitsToUint(w);
	o[i * 8u + 2u] = floatBitsToUint(m[k % 3u][(k + 1u) % 3u]);
	o[i * 8u + 3u] = u2.x + u2.y * 3u;
	o[i * 8u + 4u] = uint(iv[k & 1u][k]);
	o[i * 8u + 5u] = floatBitsToUint(dot(v3, vec3(1.0, 2.0, 3.0)));
	o[i * 8u + 6u] = inp[(i * 3u) & 1023u];
	o[i * 8u + 7u] = floatBitsToUint((m * v3).y);
}
