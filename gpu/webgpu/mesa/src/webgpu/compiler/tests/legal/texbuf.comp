#version 450
// texel buffers: a uniform texel buffer (format from the key, default RGBA32F), storage texel buffers
// with format qualifiers (r32ui with atomics, rgba8 store, rg16f load/store)
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) uniform samplerBuffer utb;
layout(set = 0, binding = 1, r32ui) uniform uimageBuffer counters;
layout(set = 0, binding = 2, rgba8) uniform writeonly imageBuffer colors;
layout(set = 0, binding = 3, rg16f) uniform imageBuffer halves;
layout(set = 0, binding = 4) buffer Out { vec4 o[]; };
void main() {
   uint i = gl_GlobalInvocationID.x;
   vec4 t = texelFetch(utb, int(i));
   imageAtomicAdd(counters, int(i % 7u), 1u);
   imageStore(colors, int(i), t * 0.5);
   vec4 h = imageLoad(halves, int(i));
   imageStore(halves, int(i), h + vec4(1.0));
   o[i] = t + vec4(textureSize(utb), imageSize(colors), 0, 0);
}
