#version 450
#extension GL_ARB_gpu_shader_int64 : require
// 32x32 -> 64 multiplies, the core of soft-fp64's multiply, on buffer values
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) buffer In { uint a[]; };
layout(set = 0, binding = 1) buffer Out { uint o[]; };
void main() {
   uint i = gl_GlobalInvocationID.x;
   uint x = a[i] * 2654435761u + 12345u, y = a[i + 100u] * 40503u + 0x9e3779b9u;
   uint hi, lo;
   umulExtended(x, y, hi, lo);
   o[4u * i] = hi;
   o[4u * i + 1u] = lo;
   uint64_t p = uint64_t(x) * uint64_t(y);
   o[4u * i + 2u] = uint(p >> 32);
   int ih, il;
   imulExtended(int(x), int(y), ih, il);
   o[4u * i + 3u] = uint(ih);
}
