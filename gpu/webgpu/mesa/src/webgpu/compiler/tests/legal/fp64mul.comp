#version 450
// legal-check: static (soft-fp64 adds differ from lavapipe in the last bit in a few % of cases: see STATUS.md)
// one soft-fp64 multiply on bit patterns from the buffer (3.0 * 0.37 in word 0: a near-tie)
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) buffer In { uint a[]; };
layout(set = 0, binding = 1) buffer Out { uvec2 o[]; };
void main() {
   uint i = gl_GlobalInvocationID.x;
   uvec2 x = uvec2(a[4u * i] * 2654435761u, 0x3ff00000u | (a[4u * i] & 0xfffffu) + i * 977u);
   uvec2 y = uvec2(a[4u * i + 1u] ^ (i * 0x9e3779b9u), 0x3fd00000u | ((i * 40503u) & 0xfffffu));
   if (i == 0u) { x = uvec2(0u, 0x40080000u); y = uvec2(0x147ae148u, 0x3fd7ae14u); }
   precise double p = packDouble2x32(x) * packDouble2x32(y);
   o[2u * i] = unpackDouble2x32(p);
   precise double s = packDouble2x32(x) + packDouble2x32(y);
   o[2u * i + 1u] = unpackDouble2x32(s);
}
