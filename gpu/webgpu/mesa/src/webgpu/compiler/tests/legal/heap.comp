#version 450
// twelve storage buffers in one stage: more than WebGPU's 10 (8 by default), so some go through the heap
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) buffer B { uint w[]; } bufs[12];
layout(set = 1, binding = 0) uniform U { uint k[64]; } u;
void main() {
   uint i = gl_GlobalInvocationID.x;
   uint acc = 0u;
   for (uint b = 0u; b < 11u; b++)
      acc += bufs[b].w[i] * (b + 1u) + uint(bufs[b].w.length());
   bufs[11].w[i] = acc + u.k[i & 63u];
   atomicAdd(bufs[10].w[512u + (i & 7u)], 1u);   // (words no invocation reads: no race)
   bufs[9].w[1000u + i] = acc;
}
