#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
// 16-bit float arithmetic (shader-f16), converted at the buffer boundary.
layout(local_size_x = 64) in;
layout(set = 0, binding = 1) buffer O { float o[]; };
layout(set = 0, binding = 2) buffer I { float inp[]; };
void main()
{
	uint i = gl_GlobalInvocationID.x;
	float16_t a = float16_t(inp[i]), b = float16_t(inp[i + 1u]);
	f16vec2 v = f16vec2(a, b) * float16_t(0.5) + f16vec2(1.0hf);
	o[i] = float(v.x * v.y - a);
}
