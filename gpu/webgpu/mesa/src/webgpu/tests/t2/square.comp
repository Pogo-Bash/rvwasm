#version 450
// out[i] = in[i] * in[i] + k (uniform), 64 per workgroup
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) readonly buffer In { uint v[]; } src;
layout(set = 0, binding = 1) buffer Out { uint v[]; } dst;
layout(set = 0, binding = 2) uniform K { uint k; } kk;
void main() {
	uint i = gl_GlobalInvocationID.x;
	dst.v[i] = src.v[i] * src.v[i] + kk.k;
}
