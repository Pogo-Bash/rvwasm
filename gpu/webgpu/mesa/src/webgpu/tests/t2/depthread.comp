#version 450
// samples a depth image as a float texture in a compute shader (WebGPU: an unfilterable sample type)
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D t;
layout(set = 0, binding = 1) buffer Out { float v[]; } o;
void main() {
	uvec2 p = gl_GlobalInvocationID.xy;
	o.v[p.y * 16u + p.x] = texelFetch(t, ivec2(p), 0).r;
}
