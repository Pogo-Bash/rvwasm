[binaries]
c = 'emcc'
cpp = 'em++'
ar = 'emar'
strip = 'emstrip'
pkg-config = 'false'

[built-in options]
c_args = ['-pthread', '-O2']
cpp_args = ['-pthread', '-O2']
c_link_args = ['-pthread']
cpp_link_args = ['-pthread']

[host_machine]
system = 'emscripten'
cpu_family = 'wasm32'
cpu = 'wasm32'
endian = 'little'
