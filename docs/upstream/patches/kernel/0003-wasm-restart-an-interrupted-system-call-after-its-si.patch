diff --git a/arch/wasm/kernel/traps.c b/arch/wasm/kernel/traps.c
index 908e533..ffcbec6 100644
--- a/arch/wasm/kernel/traps.c
+++ b/arch/wasm/kernel/traps.c
@@ -149,7 +149,14 @@ void wasm_kick_user_task(int cpu)
 				case -ERESTARTNOHAND:				\
 				case -ERESTARTSYS:				\
 				case -ERESTARTNOINTR:				\
-					restart = true;				\
+					/*					\
+					 * Not with a handler to run first: the	\
+					 * host runs it after this returns, and	\
+					 * the call is made again after that	\
+					 * (entry.S: wasm_syscall_N).		\
+					 */					\
+					restart = !test_thread_flag(		\
+						TIF_DELIVER_SIGNAL);		\
 					break;					\
 				default:					\
 					restart = false;			\
