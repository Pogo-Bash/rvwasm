 wasm_syscall_1:
 	.functype wasm_syscall_1(iLONG, iLONG, iLONG, iLONG) -> (iLONG)
-	WASM_SYSCALL_ASM_HEAD
-	local.get 2
-	local.get 3
-	call __wasm_syscall_1
