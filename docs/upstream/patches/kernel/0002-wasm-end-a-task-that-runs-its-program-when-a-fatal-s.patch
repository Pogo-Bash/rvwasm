diff --git a/arch/wasm/include/asm/thread_info.h b/arch/wasm/include/asm/thread_info.h
index 4cf08ef..1a45dc6 100644
--- a/arch/wasm/include/asm/thread_info.h
+++ b/arch/wasm/include/asm/thread_info.h
@@ -36,6 +36,13 @@ struct thread_info {
 	int			instance_depth;	/* 0 = idle task, 1 = running */
 	unsigned long		syscall_work;	/* SYSCALL_WORK_ flags */
 
+	/*
+	 * Whether the task's Worker runs its program or is in the kernel
+	 * (WASM_USER_*, traps.c): for ending a program that never comes into
+	 * the kernel again, which only the host can do.
+	 */
+	unsigned int		user_state;
+
 	/* The kernel plays tricks like casting to atomic_long_t* for flags. */
 	unsigned long		flags __aligned(L1_CACHE_BYTES);
 };
@@ -48,6 +55,17 @@ struct thread_info {
 	.instance_depth = 0,			\
 }
 
+/*
+ * thread_info.user_state (traps.c): IN_KERNEL while the task's Worker runs
+ * the kernel, RUNNING while it runs the program; KILL when a fatal signal
+ * found it RUNNING and asked the host to end that Worker; ENDING when the host
+ * has taken that on (and a new Worker takes the task through its exit).
+ */
+#define WASM_USER_IN_KERNEL	0U
+#define WASM_USER_RUNNING	1U
+#define WASM_USER_KILL		2U
+#define WASM_USER_ENDING	3U
+
 #endif /* !__ASSEMBLER__ */
 
 /* Use the generic TIF infrastructure: */
diff --git a/arch/wasm/include/asm/wasm.h b/arch/wasm/include/asm/wasm.h
index 36fd7b7..907ce56 100644
--- a/arch/wasm/include/asm/wasm.h
+++ b/arch/wasm/include/asm/wasm.h
@@ -25,4 +25,12 @@ extern void wasm_reload_program(void);
 
 extern void wasm_clone_callback(void);
 
+/*
+ * A fatal signal for a task whose Worker runs its program, which never comes
+ * into the kernel by itself: the host ends that Worker (if *user_state is
+ * still WASM_USER_KILL, which it makes WASM_USER_ENDING) and runs the task's
+ * exit in a new one (wasm_user_task_end()).
+ */
+extern void wasm_end_user_task(struct task_struct *task, unsigned int *user_state);
+
 #endif /* _ASM_WASM_WASM_H */
diff --git a/arch/wasm/kernel/entry.S b/arch/wasm/kernel/entry.S
index c1ff515..fbb0a2f 100644
--- a/arch/wasm/kernel/entry.S
+++ b/arch/wasm/kernel/entry.S
@@ -213,6 +213,34 @@ wasm_user_fault:
 	call __wasm_user_fault
 	WASM_SYSCALL_ASM_FOOT
 
+.functype __wasm_user_task_end() -> ()
+
+/*
+ * The host, in a new Worker, for a task whose Worker it has ended because a
+ * fatal signal found it running its program (traps.c): becomes the task, as
+ * ret_from_fork does, and takes it to its exit. Does not return.
+ */
+.globl wasm_user_task_end
+wasm_user_task_end:
+	.functype wasm_user_task_end(iLONG) -> ()
+
+	/* current = task */
+	local.get 0
+	global.set current
+
+	/* __stack_pointer = ALIGN_DOWN(current_switch_stack(), STACK_ALIGN) */
+	global.get current
+	iLONG.const zeroptr+TASK_STRUCT_STACK
+	iLONG.add
+	iLONG.load 0
+	iLONG.const zeroptr+THREAD_STACK_START
+	iLONG.add
+	global.set __stack_pointer
+
+	call __wasm_user_task_end
+
+	end_function
+
 .functype __wasm_syscall_0(iLONG) -> (iLONG)
 .functype __wasm_syscall_1(iLONG, iLONG) -> (iLONG)
 .functype __wasm_syscall_2(iLONG, iLONG, iLONG) -> (iLONG)
