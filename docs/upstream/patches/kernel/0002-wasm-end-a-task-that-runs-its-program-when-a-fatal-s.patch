--- a/arch/wasm/kernel/process.c
+++ b/arch/wasm/kernel/process.c
@@ -172,6 +172,7 @@ __ret_from_fork(struct task_struct *prev_task, struct task_struct *next_task)
 	 */
 	syscall_exit_to_user_mode(current_pt_regs());
 	cpuflags_overwrite(current_pt_regs()->cpuflags);
+	wasm_user_state_return(current_pt_regs());
 
 	/*
 	 * After returning, the Wasm module binary will be initialized and run.
@@ -196,6 +197,7 @@ int copy_thread(struct task_struct *p, const struct kernel_clone_args *args)
 	struct switch_stack *child_switch_stack = task_switch_stack(p);
 
 	task_thread_info(p)->flags |= _TIF_NEVER_RUN;
+	task_thread_info(p)->user_state = WASM_USER_IN_KERNEL;
 
 	if (unlikely(args->fn)) {
 		/* Kernel thread */
diff --git a/arch/wasm/kernel/smp.c b/arch/wasm/kernel/smp.c
index 55d24e6..a6dc113 100644
--- a/arch/wasm/kernel/smp.c
+++ b/arch/wasm/kernel/smp.c
@@ -142,6 +142,12 @@ void arch_send_call_function_single_ipi(int cpu)
 void arch_smp_send_reschedule(int cpu)
 {
 	preempt_disable();
+	/*
+	 * Also how a signal is said to a task running on that CPU
+	 * (kick_process()), which a task running its program never hears: a
+	 * fatal one ends it (traps.c).
+	 */
+	wasm_kick_user_task(cpu);
 	send_ipi_message(cpu, IPI_RESCHEDULE);
 	preempt_enable();
 }
diff --git a/arch/wasm/kernel/traps.c b/arch/wasm/kernel/traps.c
index 6f2a997..908e533 100644
--- a/arch/wasm/kernel/traps.c
+++ b/arch/wasm/kernel/traps.c
@@ -1,13 +1,16 @@
 /* SPDX-License-Identifier: GPL-2.0-only */
 
 #include <linux/entry-common.h>
+#include <linux/rcupdate.h>
 #include <linux/sched/signal.h>
+#include <linux/sched/task.h>
 #include <linux/syscalls.h>
