 #include <asm/entry.h>
 #include <asm/processor.h>
 #include <asm/ptrace.h>
 #include <asm/syscall.h>
+#include <asm/wasm.h>
 
 static inline void _exception_enter(struct pt_regs *regs)
 {
@@ -20,6 +23,91 @@ static inline void _exception_exit(struct pt_regs *regs)
 	cpuflags_overwrite(regs->cpuflags);
 }
 
+/*
+ * A task's program runs in its Worker until it calls into the kernel again,
+ * and nothing can interrupt Wasm code: a signal is only seen when the
+ * program makes a system call. A program that computes without making one
+ * (a loop, a thread busy with its work) cannot be stopped that way, not even
+ * by SIGKILL, and an exit_group() or exec() of another of its threads waits
+ * for it for good (zap_other_threads(), de_thread()). What the host can do is
+ * end the Worker: the program is not in the middle of anything the kernel
+ * cares about while it runs, so a new Worker can take the task through its
+ * exit (wasm_user_task_end()).
+ *
+ * Which is only safe while the Worker really is running the program, never
+ * once it has entered the kernel (it may hold locks there). thread_info's
+ * user_state says which, and a fatal signal and the task decide between them
+ * with compare-and-swap:
+ *
+ *  - The task sets it to RUNNING last thing before it returns to the program,
+ *    and then looks for a fatal signal once more (user_state_return()).
+ *  - A fatal signal that finds it RUNNING sets it to KILL and asks the host to
+ *    end the Worker (wasm_kick_user_task(), from the reschedule IPI that
+ *    signal_wake_up() sends to the task's CPU).
+ *  - The host sets KILL to ENDING before it ends the Worker; if it finds
+ *    anything else the task came into the kernel by itself, and will take
+ *    the signal there.
+ *  - The task, entering the kernel, takes RUNNING or KILL back to IN_KERNEL
+ *    (user_state_enter()). Finding ENDING, it waits to be ended.
+ *
+ * Either the signal sees RUNNING or the task sees the signal (a full barrier
+ * on both sides between the write and the read), so neither is missed.
+ */
+static noinline void user_state_wait_end(unsigned int *state)
+{
+	/* The host is ending this Worker, and another runs the task: touch nothing. */
+	for (;;)
+		__builtin_wasm_memory_atomic_wait32((int *)state, (int)WASM_USER_ENDING, -1LL);
+}
+
+static __always_inline void user_state_enter(void)
+{
+	unsigned int *state = &current_thread_info()->user_state;
+	unsigned int old = cmpxchg(state, WASM_USER_RUNNING, WASM_USER_IN_KERNEL);
+
+	if (likely(old == WASM_USER_RUNNING || old == WASM_USER_IN_KERNEL))
+		return;
+	if (old == WASM_USER_KILL &&
+	    cmpxchg(state, WASM_USER_KILL, WASM_USER_IN_KERNEL) == WASM_USER_KILL)
+		return;
+	user_state_wait_end(state);
+}
+
+static void user_exception(struct pt_regs *regs, int sig, int fatal);
+
+static __always_inline void user_state_return(struct pt_regs *regs)
+{
+	smp_store_mb(current_thread_info()->user_state, WASM_USER_RUNNING);
+	if (unlikely(fatal_signal_pending(current))) {
+		/* It came while we were on our way out, and found us in the kernel: take it now. */
+		user_state_enter();
+		user_exception(regs, 0, 0);
+	}
+}
+
+/* For a new task's first return to its program (process.c: __ret_from_fork()). */
+void wasm_user_state_return(struct pt_regs *regs)
+{
+	user_state_return(regs);
+}
+
+/* From the reschedule IPI to a CPU (smp.c): its task, if that runs its program with a fatal signal pending, is ended. */
+void wasm_kick_user_task(int cpu)
+{
+	struct task_struct *t;
+	unsigned int *state;
+
+	rcu_read_lock();
+	t = wasm_cpu_curr(cpu);
+	if (t && !(t->flags & PF_KTHREAD) && fatal_signal_pending(t)) {
+		state = &task_thread_info(t)->user_state;
+		smp_mb();
+		if (cmpxchg(state, WASM_USER_RUNNING, WASM_USER_KILL) == WASM_USER_RUNNING)
+			wasm_end_user_task(t, state);
+	}
+	rcu_read_unlock();
+}
+
 #define WASM_SYSCALL_N(x, args, cast_args, ...)					\
 	__visible long __wasm_syscall_##x args;					\
 	__visible long __wasm_syscall_##x args					\
@@ -30,6 +118,7 @@ static inline void _exception_exit(struct pt_regs *regs)
 		long syscall_args[] = {__MAP(x,__SC_ARGS,__VA_ARGS__)};		\
 		bool restart;							\
 										\
+		user_state_enter();						\
 		_exception_enter(regs);						\
 										\
 		regs->syscall_nr = n;						\
@@ -75,6 +164,8 @@ static inline void _exception_exit(struct pt_regs *regs)
 		}								\
 										\
 		_exception_exit(regs);						\
+		if (user_mode(regs))						\
+			user_state_return(regs);				\
 										\
 		return regs->syscall_ret;					\
 	}
@@ -256,10 +347,37 @@ __visible long __wasm_user_fault(long sig)
 	if (WARN_ON_ONCE(!cpuflags_test_any(CPUFLAGS_USER_MODE)))
 		return -EINVAL;
 
+	user_state_enter();
 	user_exception(regs, (int)sig, fatal);
+	user_state_return(regs);
 	return 0;
 }
 
+/*
+ * The host has ended the Worker that ran this task's program, which a fatal
+ * signal found running (user_state ENDING), and runs the task here, in a new
+ * one (entry.S: wasm_user_task_end), to its exit.
+ */
+__visible void __wasm_user_task_end(void);
+__visible void __wasm_user_task_end(void)
+{
+	struct pt_regs *regs = current_pt_regs();
+
+	WRITE_ONCE(current_thread_info()->user_state, WASM_USER_IN_KERNEL);
+	/* What the old Worker would have done on its way back to the program is nobody's now. */
+	current_thread_info()->flags &= ~(_TIF_DELIVER_SIGNAL | _TIF_RETURN_SIGNAL | _TIF_RELOAD_PROGRAM);
+
+	/* The fatal signal is pending: taken as on any return to the program. */
+	user_exception(regs, 0, 0);
+
+	/* (Not reached: no way back to the program from here.) */
+	regs->syscall_nr = -1;
+	_exception_enter(regs);
+	irqentry_enter_from_user_mode(regs);
+	local_irq_enable();
+	do_group_exit(SIGKILL);
+}
+
 /*
 * This function is called from the host when things break either in kernel code
 * or user code. That code will never continue to execute - we have to report the
diff --git a/kernel/sched/syscalls.c b/kernel/sched/syscalls.c
index cadb0e9..a76bff8 100644
--- a/kernel/sched/syscalls.c
+++ b/kernel/sched/syscalls.c
@@ -194,6 +194,17 @@ struct task_struct *idle_task(int cpu)
 	return cpu_rq(cpu)->idle;
 }
 
+#ifdef CONFIG_WASM
+/*
+ * The task a CPU is running by the scheduler's account (rq->curr), for
+ * arch/wasm/kernel/traps.c: the one a reschedule IPI to that CPU is for.
+ */
+struct task_struct *wasm_cpu_curr(int cpu)
+{
+	return cpu_rq(cpu)->curr;
+}
+#endif
+
