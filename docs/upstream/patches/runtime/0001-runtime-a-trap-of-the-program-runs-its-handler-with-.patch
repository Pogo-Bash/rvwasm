From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: rvwasm <rvwasm@localhost>
Date: Sat, 10 Oct 2026 23:40:28 -0500
Subject: [PATCH 1/3] runtime: a trap of the program runs its handler, with the
 signal the trap means

A trap of a program's code (an access out of bounds, a division by zero,
unreachable) went to the kernel's raise_exception(), which made it SIGILL;
with a handler for it (crash reporters have one) the kernel set up the
handler's frame and nothing ran it, and the task hung for good.

Now, when the CPU is in user mode (the kernel's wasm_user_mode_now()), the
host calls the kernel's wasm_user_fault with the program's stack pointer and
TLS and the signal the trap means: SIGSEGV for an access out of bounds, a
call through a bad function pointer or a stack that ran out, SIGFPE for a
division by zero or an integer conversion out of range, SIGILL for the rest.
The handler runs on the way out, as at the return of a system call; it may
exit, or exec. A handler that returns is followed by a second call with
-sig, and the program dies by the signal. A trap in the handler goes the
same way again (its own signal is blocked there, so that one is fatal). A
kernel without wasm_user_fault gets raise_exception() as before.

Needs the kernel patch "wasm: run the handler of a trap of the program".

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 runtime/linux-worker.js | 42 +++++++++++++++++++++++++++++++++++++++++
 1 file changed, 42 insertions(+)

diff --git a/runtime/linux-worker.js b/runtime/linux-worker.js
index aee2580..8dd4bcd 100644
--- a/runtime/linux-worker.js
+++ b/runtime/linux-worker.js
@@ -27,6 +27,24 @@
   let user_executable_instance = null;
   let user_executable_imports = null;
 
+  /// What a trap of the program means as a signal: SIGFPE for arithmetic, SIGSEGV for a bad address (of data, of a
+  /// function, the stack), SIGILL for the rest (unreachable, an error of the runtime).
+  const trap_signal = (error) => {
+    const text = String(error && error.message !== undefined ? error.message : error);
+    if (error instanceof WebAssembly.RuntimeError &&
+        /divide by zero|remainder by zero|divide result unrepresentable|float unrepresentable|integer overflow|invalid conversion to integer/.test(text)) {
+      return 8;
+    }
+    if (error instanceof RangeError ||
+        (error instanceof WebAssembly.RuntimeError &&
+         /out of bounds|null function|signature mismatch|null pointer|invalid index into function table/.test(text))) {
+      return 11;
+    }
+    return 4;
+  };
+  /// How many traps in a row, a handler's own included: past a few, no handler is run any more.
+  let fault_depth = 0;
+
   /// Flag that a clone callback should be called instead of _start().
   let should_call_clone_callback = false;
 
@@ -312,6 +330,30 @@
         console.error(error);
 
         if (vmlinux_instance) {
+          // A trap of the program (the CPU is in user mode): the kernel makes a signal of it, whose handler runs on
+          // the way out of wasm_user_fault, as at the return of a system call. A trap cannot be resumed: if the
+          // handler returns, the program dies by the signal (-sig). Without the program's instance (it did not get
+          // to run) no handler can run, nor in handler after handler that traps itself.
+          const exports = vmlinux_instance.exports;
+          if (exports.wasm_user_fault && exports.wasm_user_mode_now()) {
+            const sig = trap_signal(error);
+            const sp = user_executable_imports ? user_executable_imports.env.__stack_pointer.value : exports.get_user_stack_pointer();
+            const tls = user_executable_instance && user_executable_instance.exports.__get_tls_base ?
+              user_executable_instance.exports.__get_tls_base() : exports.get_user_tls_base();
+            const handler = user_executable_instance && fault_depth < 4;
+            fault_depth++;
+            try {
+              if (handler) {
+                exports.wasm_user_fault(sp, tls, Ulong(sig));
+              }
+              exports.wasm_user_fault(sp, tls, Ulong(-sig));
+            } catch (next) {
+              // The handler called exec (a Trap), or trapped itself (a trap again: its own signal is blocked there).
+              return user_executable_error(next);
+            }
+            log("the kernel did not end a program that trapped (signal " + sig + ")");
+            return;
+          }
           vmlinux_instance.exports.raise_exception();
           throw new Error("raise_exception() returned");
         } else {
